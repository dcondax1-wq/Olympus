//@version=5
// =====================================================================================================
//  LIQUIDITY ENGINE - eval mode, locked 2026-10-17   (Pine port of engine/model.py + live_model.json + engine/equity_filter.py)
//  Run on MNQ1! 5-minute (CME, ETH). ONE TradingView alert on this strategy: condition "Order fills and alert() function
//  calls", message {{strategy.order.alert_message}}. Input "Alert format" picks what the message is:
//    Bridge JSON - for a webhook to TradersPost or PickMyTrade, which places the order in Tradovate (MFFU)
//    Phone text  - plain text for the TradingView app, e.g. "LONG 12 MNQ at market · stop 29,880.25 · target 29,990.50 ·
//                  risk $780", and you place the order yourself
//  Setup and the Sunday checklist: tradingview/BRIDGE_SETUP.md. Exact rules: STRATEGY.md.
//
//  Rules (same as the Python bot):
//   1. Liquidity pools: prior-day H/L, prior-week H/L, Asia/London/overnight H/L, 1H swings and equal highs/lows within
//      6 pts (major); 15m swings (minor).
//   2. A pool is swept (trade-through >= 1 tick) from 08:00 ET -> arm the opposite direction.
//   3. Trigger in the NY killzones (09:30-11:30, 13:30-15:30 ET): first body close through an FVG inside the manipulation
//      leg (IFVG); CISD close-through when the leg has no FVG. Fill at the next bar's open.
//   4. Score >= 1:  +1 1H trend aligned (-1 against) | +1 sweep in discount (long) / premium (short) of the 1H swing range
//      | +1 clean path (<=1 unswept swing to target, -1 if >=3) | -1 15m already aligned (late).
//   5. Stop beyond the sweep extreme (+2 pts), 10-60 pts (too wide: the far side of the inverted gap if that fits, else
//      no trade).
//   6. Target = nearest MAJOR untaken pool >= 1.5R away, 1 tick in front of it; profit banked at 5R when the draw is
//      farther. No major pool in range = no trade.
//   7. Breakeven at +1R. Exit if not +0.5R after 30 min. Giveback exit: was +0.5R, then a close back through entry.
//      Flat 15:55 ET (or the session's last bar on early-close days). News blackout from the release list (prefilled
//      from the engine's calendar; refresh with tools/pine_news.py).
//   8. Size: $800 risk up to a 20-pt stop; wider stops risk $800 x 20 / stop. Micros = floor(risk / (stop x $2)), max 40.
//      Half size in a trending regime (10-day efficiency > 0.45). 1 trade/day, stop after a winner, $600 daily stop,
//      no entries once the day's range is >= 1.6x the 20-day average.
//   9. Cold-streak filter: if the R of the last 15 closed trades sums to <= 0, the trade is still taken at half size
//      (micros x 0.5, at least 1). TradingView builds this record from the trades in the loaded chart history (full
//      size until 15 trades have closed); the Python bot uses its shadow ledger.
//  Parity with the Python engine is checked trade by trade with tools/pine_sim.py (a bar-by-bar replica of this script
//  and of TradingView's fills) and tools/pine_parity.py - see research/PINE_PARITY.md. Remaining differences are listed
//  in tradingview/BRIDGE_SETUP.md section 7.
// =====================================================================================================
strategy("Liquidity Engine - Sweep IFVG DOL", overlay=true, initial_capital=50000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.75, slippage=1, calc_on_order_fills=false, backtest_fill_limits_assumption=1,
     max_bars_back=600, max_lines_count=200, max_labels_count=300)

VERSION = "eval mode 2026-10-17"

// ---------------------------------------------------------------- inputs
grpR = "Risk and size"
riskUsd      = input.float(800, "Risk per trade ($)", group=grpR, tooltip="Full risk when the stop is no wider than the reference stop below.")
refStop      = input.float(20.0, "Full risk up to a stop of (pts, 0 = off)", group=grpR, tooltip="Wider stops risk less: risk = Risk per trade x this / stop. $800 x 20 / 40-pt stop = $400. Micros = risk / (stop x $2), rounded down.")
maxQty       = input.int(40, "Max contracts (micros on MNQ)", group=grpR)
maxTrades    = input.int(1, "Max trades / day", group=grpR)
stopAfterWin = input.bool(true, "Stop after a winner", group=grpR)
dayStop      = input.float(600, "Daily loss stop ($)", group=grpR)
regimeEr     = input.float(0.45, "Trending regime: 10-day efficiency above (0 = off)", group=grpR)
regimeMode   = input.string("half", "In a trending regime", options=["half", "skip"], group=grpR)
dayRangeMax  = input.float(1.6, "No entries once day range >= x 20d avg (0 = off)", group=grpR)
grpC = "Cold-streak filter"
coldOn    = input.bool(true, "Smaller size in a cold streak", group=grpC, tooltip="Before each entry the strategy adds up the R of the last N closed trades. At or below the threshold the trade is still taken, at the smaller size. On TradingView the record comes from the trades in the loaded chart history (full size until N trades have closed); the Python bot uses its shadow ledger.")
coldLook  = input.int(15, "Closed trades to add up (N)", minval=1, group=grpC)
coldMinR  = input.float(0.0, "Cold when they sum to or below (R)", group=grpC)
coldMult  = input.float(0.5, "Size in a cold streak (x micros, at least 1)", minval=0.01, maxval=1.0, group=grpC)
coldForce = input.string("Auto", "Override", options=["Auto", "Always full size", "Always cold"], group=grpC, tooltip="Auto = from the closed trades on this chart. Use an override only if the chart history is too short and the Python dashboard shows a different cold-streak state; re-create the alert after changing it.")
grpO = "Old rules (off in the locked strategy)"
gradeSizing = input.bool(false, "Grade sizing A+..D (old: $350 x grade)", group=grpO)
convStep    = input.float(0.0, "Conviction step (old; only when grade sizing is off)", group=grpO)
ddAware     = input.bool(false, "Cap risk at a fraction of the MLL cushion (old)", group=grpO)
cushionFrac = input.float(0.25, "Cushion fraction", group=grpO)
mllAmt      = input.float(2000, "Trailing max loss ($, EOD)", group=grpO)
mllLock     = input.float(50100, "MLL locks at", group=grpO)
useFallback = input.bool(false, "No major pool in range: fixed-R target instead of no trade (old)", group=grpO)
fallbackRR  = input.float(2.0, "Fallback R", group=grpO)
gEarly      = input.int(2, "Grade penalty: first 45 min of the session", group=grpO)
gQ3         = input.int(1, "Grade penalty: Q3 entry", group=grpO)
gPd         = input.int(2, "Grade weight: 1H discount/premium", group=grpO)
grpM = "Model"
minFvg    = input.float(3.0, "Min FVG size (pts)", group=grpM)
minStop   = input.float(10.0, "Min stop (pts)", group=grpM)
maxStop   = input.float(60.0, "Max stop (pts)", group=grpM)
stopBuf   = input.float(2.0, "Stop buffer beyond sweep (pts)", group=grpM)
eqTol     = input.float(6.0, "Equal highs/lows tolerance (pts)", group=grpM)
minRR     = input.float(1.5, "Min R to draw on liquidity", group=grpM)
maxRR     = input.float(5.0, "Bank profit at (R) when the draw is farther", group=grpM)
beAtR     = input.float(1.0, "Breakeven at (R, 0=off)", group=grpM)
timeStopM = input.int(30, "Time stop (min, 0=off)", group=grpM)
givebackR = input.float(0.5, "Giveback exit after (R, 0=off)", group=grpM, tooltip="Reached this many R, then a bar closes back below entry: exit at the close.")
minScore  = input.int(1, "Min confluence score", group=grpM)
expiryMin = input.int(60, "Setup expiry (min)", group=grpM)
legLook   = input.int(24, "Leg lookback (bars)", group=grpM)
flatMod   = input.int(955, "Flat at (ET minutes after midnight, 955 = 15:55)", group=grpM)
rollAdj   = input.bool(true, "Shift remembered levels at contract rolls", group=grpM,
     tooltip="The Python engine trades back-adjusted NQ. At a roll of the continuous contract every remembered level (pools, day/week highs and lows, 1H/15m structure, regime closes) is moved by the roll gap, measured against the back-adjusted copy of this symbol.")
grpN = "News blackout"
newsOn     = input.bool(true, "Block entries around listed releases", group=grpN)
newsList   = input.text_area("2026-08-07 08:30 Non-Farm Payrolls (jobs report);2026-08-12 08:30 CPI (consumer inflation);2026-09-04 08:30 Non-Farm Payrolls (jobs report);2026-09-11 08:30 CPI (consumer inflation);2026-09-16 14:00 FOMC rate decision + projections;2026-09-16 14:30 FOMC press conference;2026-10-02 08:30 Non-Farm Payrolls (jobs report);2026-10-14 08:30 Core CPI m/m;2026-10-15 08:30 Core PPI m/m;2026-10-15 23:30 Fed Chairman Warsh Speaks;2026-10-27 10:00 CB Consumer Confidence;2026-10-28 14:00 FOMC rate decision;2026-10-28 14:30 FOMC press conference;2026-10-29 08:30 GDP Q3 advance estimate;2026-11-02 10:00 ISM Manufacturing PMI;2026-11-03 10:00 JOLTS Job Openings (Sep);2026-11-04 08:15 ADP Non-Farm Employment (Oct);2026-11-04 10:00 ISM Services PMI;2026-11-06 08:30 Non-Farm Payrolls (jobs report);2026-11-10 08:30 CPI (consumer inflation);2026-11-13 08:30 PPI (producer inflation);2026-11-18 14:00 Fed meeting minutes (Oct 27-28);2026-12-09 14:00 FOMC rate decision + projections;2026-12-09 14:30 FOMC press conference;2027-01-27 14:00 FOMC rate decision;2027-01-27 14:30 FOMC press conference;2027-03-17 14:00 FOMC rate decision + projections;2027-03-17 14:30 FOMC press conference;2027-04-28 14:00 FOMC rate decision;2027-04-28 14:30 FOMC press conference;2027-06-09 14:00 FOMC rate decision + projections;2027-06-09 14:30 FOMC press conference;2027-07-28 14:00 FOMC rate decision;2027-07-28 14:30 FOMC press conference;2027-09-15 14:00 FOMC rate decision + projections;2027-09-15 14:30 FOMC press conference;2027-10-27 14:00 FOMC rate decision;2027-10-27 14:30 FOMC press conference;2027-12-08 14:00 FOMC rate decision + projections;2027-12-08 14:30 FOMC press conference", "Release times (ET), one per line or ';' separated: YYYY-MM-DD HH:MM label", group=grpN,
     tooltip="High-impact USD releases (the engine's calendar; refresh with: python -X utf8 tools/pine_news.py). Format:\n2026-10-21 08:30 CPI\n2026-10-29 14:00 FOMC\nHH:MM must be two digits. A label containing FOMC also blocks entries after 13:00 that day.")
newsBefore = input.int(15, "Minutes before", group=grpN)
newsAfter  = input.int(30, "Minutes after", group=grpN)
newsFlatM  = input.int(5, "Flatten an open trade this many minutes before (0 = off)", group=grpN)
fomcPmOff  = input.bool(true, "FOMC day: no entries after 13:00", group=grpN)
grpA = "Alerts"
alertFmt   = input.string("Bridge JSON", "Alert format", options=["Bridge JSON", "Phone text"], group=grpA, tooltip="Bridge JSON: messages for a webhook to TradersPost or PickMyTrade, which place the orders in Tradovate. Phone text: plain messages for the TradingView app (e.g. LONG 12 MNQ at market · stop 29,880.25 · target 29,990.50 · risk $780) and you place the orders yourself.")
bridge     = input.string("TradersPost", "Bridge (Bridge JSON only)", options=["TradersPost", "PickMyTrade"], group=grpA)
bTicker    = input.string("MNQ", "Ticker / symbol in the alerts", group=grpA, tooltip="Symbol the bridge maps to the Tradovate contract (MNQ1! chart -> MNQ). TradersPost also accepts an explicit contract such as MNQZ2026.")
syncExits  = input.bool(true, "Alert when TradingView's own stop/target fills", group=grpA, tooltip="Bridge JSON: sends an exit so the broker is flat too (harmless when the broker bracket already closed the trade). Phone text: tells you to check that the broker is flat with no orders left.")
beModify   = input.bool(true, "Alert the breakeven stop move", group=grpA)
pmtToken   = input.string("", "PickMyTrade token", group=grpA, tooltip="Type it here on TradingView only. Never put it in the repo or a chat.")
pmtAccount = input.string("", "PickMyTrade account_id", group=grpA)
showTable  = input.bool(true, "Show the status box", group="Display")

tz = "America/New_York"
tick = syminfo.mintick
barSecs = timeframe.in_seconds()
barMs = barSecs * 1000
DAY = 86400000
COMM = 0.75          // keep in sync with strategy(commission_value)
SLIPT = 1            // keep in sync with strategy(slippage), ticks

// ---------------------------------------------------------------- clock (ET)
mod = hour(time, tz) * 60 + minute(time, tz)
gapMs = time - nz(time[1], time)
newDay = (mod >= 1080 and (nz(mod[1], 0) < 1080 or gapMs > 6 * 3600000)) or (mod < 1080 and gapMs > 4 * 3600000)
inKZ = (mod >= 570 and mod < 690) or (mod >= 810 and mod < 930)
canArm = mod >= 480 and mod < flatMod
curDate = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)

// ---------------------------------------------------------------- state
// liquidity pools
var float[] pPx    = array.new_float()
var int[]   pSide  = array.new_int()     // +1 buy-side (high), -1 sell-side (low)
var bool[]  pMajor = array.new_bool()
var bool[]  pSwing = array.new_bool()    // 1H / 15m swing (counts as an obstacle on the path)
var int[]   pStr   = array.new_int()     // pool strength (PW 3, PD/ON/LO/H1 2, AS/ITH 1)
var bool[]  pEqOk  = array.new_bool()    // may take part in equal highs/lows (every kind except prior week)
var int[]   pBorn  = array.new_int()
var int[]   pLife  = array.new_int()     // lifetime in ms
// day / week / sessions
var float dHi = na
var float dLo = na
var float wHi = na
var float wLo = na
var float asH = na
var float asL = na
var bool asPub = false
var float loH = na
var float loL = na
var bool loPub = false
var float onH = na
var float onL = na
var bool onPub = false
var int curWeek = na
var int tradesToday = 0
var float dayStartNet = 0.0
var bool wonToday = false
var float vwPV = 0.0
var float vwV = 0.0
// day-level context (known before the open, like Engine._day_regime)
var float[] dRanges = array.new_float()
var float[] dCloses = array.new_float()
var float adr20 = na
var bool trending = false
var float peakEod = strategy.initial_capital
var float mllLvl = strategy.initial_capital - mllAmt
var float[] qOpen = array.new_float(7, na)     // Quarterly Theory 90-min "true opens" (quarter start + 20 min)
// 1H / 15m structure (exactly like engine.model.Structure: 2-bar fractals, BOS/CHoCH, protected low/high).
// Plain var state, no objects or methods: the earlier UDT/method version never updated on TradingView (every
// trade scored exactly 1 with no 1H trend, no dealing range and no swing pools).
var float[] hH = array.new_float()     // 1H: last 13 closed candles
var float[] hL = array.new_float()
var float hSh = na                          // last unbroken swing high (BOS level) and the lowest low since it
var float hShMin = na
var float hSl = na
var float hSlMax = na
var int   hTrend = 0                        // +1 / -1 after BOS / CHoCH, flipped when the protected low / high breaks
var float hProtL = na
var float hProtH = na
var float hLsh = na                         // latest confirmed swing high / low (dealing range)
var float hLsl = na
var int   hB = na                           // aggregation bucket and its running high / low / close
var float hAh = na
var float hAl = na
var float hAc = na
var bool  hDone = true
float hNewH = na                            // swing confirmed on this bar (-> liquidity pool)
float hNewL = na
var float[] mH = array.new_float()     // 15m: last 13 closed candles
var float[] mL = array.new_float()
var float mSh = na                          // last unbroken swing high (BOS level) and the lowest low since it
var float mShMin = na
var float mSl = na
var float mSlMax = na
var int   mTrend = 0                        // +1 / -1 after BOS / CHoCH, flipped when the protected low / high breaks
var float mProtL = na
var float mProtH = na
var float mLsh = na                         // latest confirmed swing high / low (dealing range)
var float mLsl = na
var int   mB = na                           // aggregation bucket and its running high / low / close
var float mAh = na
var float mAl = na
var float mAc = na
var bool  mDone = true
float mNewH = na                            // swing confirmed on this bar (-> liquidity pool)
float mNewL = na
// armed setups
var bool  lArmed = false
var float lExt = na
var int   lExtTime = 0
var int   lExtBar = 0
var int   lArmMod = 0
var float lVavg = na
var float lVrun = 0.0
var float lVmax = 0.0
var bool  sArmed = false
var float sExt = na
var int   sExtTime = 0
var int   sExtBar = 0
var int   sArmMod = 0
var float sVavg = na
var float sVrun = 0.0
var float sVmax = 0.0
// open position
var float trStop = na
var float trStop0 = na                      // stop at entry: the trade's R is measured against this distance
var float trTgt = na
var float trEntry = na
var float trRisk = na
var int   trBar = 0
var float trMfe = 0.0
var bool  beSent = false
var int   lastTrades = 0
// cold-streak record: every closed trade's R, from its own entry risk (fill to the stop at entry)
var float[] entStop = array.new_float()     // stop of every entry order, oldest first (closed trade k <-> entStop[k])
var float[] coldR   = array.new_float()     // R of every closed trade on this chart, oldest first
var int     coldDone = 0                    // closed trades already in coldR

// ---------------------------------------------------------------- contract roll (back-adjusted offset)
// rollOff = this bar's price minus the back-adjusted price; it changes by the roll gap on the first bar of a new
// contract. Shifting every remembered level by that change reproduces the engine's back-adjusted history.
adjTicker = ticker.modify(syminfo.tickerid, backadjustment = backadjustment.on)
adjClose = request.security(adjTicker, timeframe.period, close)
rollOff = close - adjClose
rollD = rollAdj and not na(rollOff) and not na(rollOff[1]) and math.abs(rollOff - rollOff[1]) >= tick / 2 ? rollOff - rollOff[1] : 0.0
if rollD != 0.0
    if array.size(pPx) > 0
        for k = 0 to array.size(pPx) - 1
            array.set(pPx, k, array.get(pPx, k) + rollD)
    if array.size(dCloses) > 0
        for k = 0 to array.size(dCloses) - 1
            array.set(dCloses, k, array.get(dCloses, k) + rollD)
    dHi += rollD
    dLo += rollD
    wHi += rollD
    wLo += rollD
    asH += rollD
    asL += rollD
    loH += rollD
    loL += rollD
    onH += rollD
    onL += rollD
    lExt += rollD
    sExt += rollD
    vwPV += vwV * rollD
    hSh += rollD
    hShMin += rollD
    hSl += rollD
    hSlMax += rollD
    hProtL += rollD
    hProtH += rollD
    hLsh += rollD
    hLsl += rollD
    hAh += rollD
    hAl += rollD
    hAc += rollD
    if array.size(hH) > 0
        for k = 0 to array.size(hH) - 1
            array.set(hH, k, array.get(hH, k) + rollD)
            array.set(hL, k, array.get(hL, k) + rollD)
    mSh += rollD
    mShMin += rollD
    mSl += rollD
    mSlMax += rollD
    mProtL += rollD
    mProtH += rollD
    mLsh += rollD
    mLsl += rollD
    mAh += rollD
    mAl += rollD
    mAc += rollD
    if array.size(mH) > 0
        for k = 0 to array.size(mH) - 1
            array.set(mH, k, array.get(mH, k) + rollD)
            array.set(mL, k, array.get(mL, k) + rollD)
// ---------------------------------------------------------------- liquidity pools
f_addPool(float px, int side, bool major, bool swing, int strength, bool eqOk, int lifeMs, bool checkEq, int born) =>
    idx = -1
    n = array.size(pPx)
    if n > 0 and not na(px)
        for k = 0 to n - 1
            if idx < 0 and array.get(pSide, k) == side and math.abs(array.get(pPx, k) - px) < tick / 2
                idx := k
                if major
                    array.set(pMajor, k, true)
                if strength > array.get(pStr, k)       // the stronger kind names the merged level
                    array.set(pStr, k, strength)
                    array.set(pSwing, k, swing)
                    array.set(pEqOk, k, eqOk)
                    array.set(pLife, k, lifeMs)
    if idx < 0 and not na(px)
        array.push(pPx, px)
        array.push(pSide, side)
        array.push(pMajor, major)
        array.push(pSwing, swing)
        array.push(pStr, strength)
        array.push(pEqOk, eqOk)
        array.push(pBorn, born)
        array.push(pLife, lifeMs)
        idx := array.size(pPx) - 1
    if checkEq and idx >= 0
        m = array.size(pPx)
        for k = 0 to m - 1
            if k != idx and array.get(pSide, k) == side and array.get(pEqOk, k)
                dd = math.abs(array.get(pPx, k) - array.get(pPx, idx))
                if dd >= tick / 2 and dd <= eqTol
                    array.set(pMajor, k, true)
                    array.set(pMajor, idx, true)
    idx

f_removePool(int k) =>
    array.remove(pPx, k)
    array.remove(pSide, k)
    array.remove(pMajor, k)
    array.remove(pSwing, k)
    array.remove(pStr, k)
    array.remove(pEqOk, k)
    array.remove(pBorn, k)
    array.remove(pLife, k)

if newDay
    // retire stale pools first (engine order), then add the prior day / prior week levels: a fresh prior-week high
    // that lands on an old level must not be retired together with it
    if array.size(pPx) > 0
        for k = array.size(pPx) - 1 to 0
            if time - array.get(pBorn, k) > array.get(pLife, k)
                f_removePool(k)
    if not na(dHi)
        array.push(dRanges, dHi - dLo)
        array.push(dCloses, close[1] + rollD)
        balEod = strategy.initial_capital + strategy.netprofit
        peakEod := math.max(peakEod, balEod)
        mllLvl := math.min(math.max(mllLvl, peakEod - mllAmt), mllLock)
        if high <= dHi
            f_addPool(dHi, 1, true, false, 2, true, int(2.2 * DAY), false, time)
        if low >= dLo
            f_addPool(dLo, -1, true, false, 2, true, int(2.2 * DAY), false, time)
    nR = array.size(dRanges)
    if nR > 0
        sR = 0.0
        cnt = math.min(20, nR)
        for k = nR - cnt to nR - 1
            sR += array.get(dRanges, k)
        adr20 := sR / cnt
    trending := false
    nC = array.size(dCloses)
    if regimeEr > 0 and nC >= 11
        path = 0.0
        for k = nC - 10 to nC - 1
            path += math.abs(array.get(dCloses, k) - array.get(dCloses, k - 1))
        if path > 0
            trending := math.abs(array.get(dCloses, nC - 1) - array.get(dCloses, nC - 11)) / path > regimeEr
    wk = weekofyear(time + 6 * 3600000, tz)
    if not na(curWeek) and wk != curWeek and not na(wHi)
        f_addPool(wHi, 1, true, false, 3, false, 5 * DAY, false, time)
        f_addPool(wLo, -1, true, false, 3, false, 5 * DAY, false, time)
        wHi := na
        wLo := na
    curWeek := wk
    dHi := high
    dLo := low
    asH := na
    asL := na
    asPub := false
    loH := na
    loL := na
    loPub := false
    onH := na
    onL := na
    onPub := false
    tradesToday := 0
    dayStartNet := strategy.netprofit
    wonToday := false
    for k = 0 to 6
        array.set(qOpen, k, na)
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
wHi := math.max(nz(wHi, high), high)
wLo := math.min(nz(wLo, low), low)

// HTF structure + swing pools (born at the 1H / 15m candle close, like the engine)
// ---- 1H candle: aggregated from the chart's 5m bars and processed on the 5m bar that completes it (closed bars only)
hBk = int(math.floor(time / 3600000))
float hStH = na
float hStL = na
float hStC = na
bool hStale = false
if na(hB) or hBk != hB
    if not na(hB) and not hDone
        hStale := true                      // the bucket ended without its last 5m bar (data gap): close it now
        hStH := hAh
        hStL := hAl
        hStC := hAc
    hB := hBk
    hAh := high
    hAl := low
    hAc := close
    hDone := false
else
    hAh := math.max(hAh, high)
    hAl := math.min(hAl, low)
    hAc := close
hComplete = (time + barMs) % 3600000 == 0
if hComplete
    hDone := true
for hPass = 0 to 1
    if hPass == 0 ? hStale : hComplete
        hbh = hPass == 0 ? hStH : hAh
        hbl = hPass == 0 ? hStL : hAl
        hbc = hPass == 0 ? hStC : hAc
        array.push(hH, hbh)
        array.push(hL, hbl)
        if array.size(hH) > 13
            array.shift(hH)
            array.shift(hL)
        hn = array.size(hH)
        if not na(hShMin)
            hShMin := math.min(hShMin, hbl)
        if not na(hSlMax)
            hSlMax := math.max(hSlMax, hbh)
        if hn >= 5
            hhk = array.get(hH, hn - 3)
            hlk = array.get(hL, hn - 3)
            if hhk > math.max(array.get(hH, hn - 5), array.get(hH, hn - 4)) and hhk >= math.max(array.get(hH, hn - 2), array.get(hH, hn - 1))
                hSh := hhk
                hLsh := hhk
                hNewH := hhk
                hShMin := math.min(hlk, math.min(array.get(hL, hn - 2), array.get(hL, hn - 1)))
            if hlk < math.min(array.get(hL, hn - 5), array.get(hL, hn - 4)) and hlk <= math.min(array.get(hL, hn - 2), array.get(hL, hn - 1))
                hSl := hlk
                hLsl := hlk
                hNewL := hlk
                hSlMax := math.max(hhk, math.max(array.get(hH, hn - 2), array.get(hH, hn - 1)))
        if not na(hSh) and hbc > hSh
            hProtL := hShMin
            hTrend := 1
            hSh := na
            hShMin := na
        else if not na(hSl) and hbc < hSl
            hProtH := hSlMax
            hTrend := -1
            hSl := na
            hSlMax := na
        if hTrend == 1 and not na(hProtL) and hbc < hProtL
            hTrend := -1
            hProtH := array.max(hH)
        else if hTrend == -1 and not na(hProtH) and hbc > hProtH
            hTrend := 1
            hProtL := array.min(hL)

// ---- 15m candle: aggregated from the chart's 5m bars and processed on the 5m bar that completes it (closed bars only)
mBk = int(math.floor(time / 900000))
float mStH = na
float mStL = na
float mStC = na
bool mStale = false
if na(mB) or mBk != mB
    if not na(mB) and not mDone
        mStale := true                      // the bucket ended without its last 5m bar (data gap): close it now
        mStH := mAh
        mStL := mAl
        mStC := mAc
    mB := mBk
    mAh := high
    mAl := low
    mAc := close
    mDone := false
else
    mAh := math.max(mAh, high)
    mAl := math.min(mAl, low)
    mAc := close
mComplete = (time + barMs) % 900000 == 0
if mComplete
    mDone := true
for mPass = 0 to 1
    if mPass == 0 ? mStale : mComplete
        mbh = mPass == 0 ? mStH : mAh
        mbl = mPass == 0 ? mStL : mAl
        mbc = mPass == 0 ? mStC : mAc
        array.push(mH, mbh)
        array.push(mL, mbl)
        if array.size(mH) > 13
            array.shift(mH)
            array.shift(mL)
        mn = array.size(mH)
        if not na(mShMin)
            mShMin := math.min(mShMin, mbl)
        if not na(mSlMax)
            mSlMax := math.max(mSlMax, mbh)
        if mn >= 5
            mhk = array.get(mH, mn - 3)
            mlk = array.get(mL, mn - 3)
            if mhk > math.max(array.get(mH, mn - 5), array.get(mH, mn - 4)) and mhk >= math.max(array.get(mH, mn - 2), array.get(mH, mn - 1))
                mSh := mhk
                mLsh := mhk
                mNewH := mhk
                mShMin := math.min(mlk, math.min(array.get(mL, mn - 2), array.get(mL, mn - 1)))
            if mlk < math.min(array.get(mL, mn - 5), array.get(mL, mn - 4)) and mlk <= math.min(array.get(mL, mn - 2), array.get(mL, mn - 1))
                mSl := mlk
                mLsl := mlk
                mNewL := mlk
                mSlMax := math.max(mhk, math.max(array.get(mH, mn - 2), array.get(mH, mn - 1)))
        if not na(mSh) and mbc > mSh
            mProtL := mShMin
            mTrend := 1
            mSh := na
            mShMin := na
        else if not na(mSl) and mbc < mSl
            mProtH := mSlMax
            mTrend := -1
            mSl := na
            mSlMax := na
        if mTrend == 1 and not na(mProtL) and mbc < mProtL
            mTrend := -1
            mProtH := array.max(mH)
        else if mTrend == -1 and not na(mProtH) and mbc > mProtH
            mTrend := 1
            mProtL := array.min(mL)
if not na(hNewH)
    f_addPool(hNewH, 1, true, true, 2, true, 5 * DAY, true, time + barMs)
if not na(hNewL)
    f_addPool(hNewL, -1, true, true, 2, true, 5 * DAY, true, time + barMs)
if not na(mNewH)
    f_addPool(mNewH, 1, false, true, 1, true, int(1.2 * DAY), true, time + barMs)
if not na(mNewL)
    f_addPool(mNewL, -1, false, true, 1, true, int(1.2 * DAY), true, time + barMs)

// Quarterly Theory true opens: 06:20, 07:50, 09:20, 10:50, 12:20, 13:50, 15:20 ET
if mod >= 380 and mod <= 920 and (mod - 380) % 90 == 0
    array.set(qOpen, int((mod - 380) / 90), open)

// RTH VWAP (AMT fair value proxy)
if mod == 570 or (mod >= 570 and nz(mod[1], 0) < 570)
    vwPV := 0.0
    vwV := 0.0
if mod >= 570 and mod < 960
    vwPV += hlc3 * (volume > 0 ? volume : 1)
    vwV += volume > 0 ? volume : 1
vwap = vwV > 0 ? vwPV / vwV : na

// sessions
if mod >= 1200
    asH := math.max(nz(asH, high), high)
    asL := math.min(nz(asL, low), low)
else if not na(asH) and not asPub and mod < 1080
    asPub := true
    f_addPool(asH, 1, true, false, 1, true, int(2.2 * DAY), true, time)
    f_addPool(asL, -1, true, false, 1, true, int(2.2 * DAY), true, time)
if mod >= 120 and mod < 300
    loH := math.max(nz(loH, high), high)
    loL := math.min(nz(loL, low), low)
else if not na(loH) and not loPub and mod >= 300 and mod < 1080
    loPub := true
    f_addPool(loH, 1, true, false, 2, true, int(2.2 * DAY), true, time)
    f_addPool(loL, -1, true, false, 2, true, int(2.2 * DAY), true, time)
if mod >= 1080 or mod < 570
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)
else if not na(onH) and not onPub and mod >= 570 and mod < 1080
    onPub := true
    f_addPool(onH, 1, true, false, 2, true, int(2.2 * DAY), false, time)
    f_addPool(onL, -1, true, false, 2, true, int(2.2 * DAY), false, time)

// ---------------------------------------------------------------- news blackout list (parsed once)
var int[]  evT    = array.new_int()
var int[]  evDate = array.new_int()
var bool[] evFomc = array.new_bool()
if barstate.isfirst and newsOn
    items = str.split(str.replace_all(newsList, ";", "\n"), "\n")
    for it in items
        m = str.match(it, "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}")
        if str.length(m) == 16
            y  = int(str.tonumber(str.substring(m, 0, 4)))
            mo = int(str.tonumber(str.substring(m, 5, 7)))
            dy = int(str.tonumber(str.substring(m, 8, 10)))
            hh = int(str.tonumber(str.substring(m, 11, 13)))
            mi = int(str.tonumber(str.substring(m, 14, 16)))
            array.push(evT, timestamp(tz, y, mo, dy, hh, mi))
            array.push(evDate, y * 10000 + mo * 100 + dy)
            array.push(evFomc, str.contains(str.upper(it), "FOMC"))

f_newsBlock() =>
    blk = false
    n = array.size(evT)
    if newsOn and n > 0
        for k = 0 to n - 1
            ev = array.get(evT, k)
            if ev >= time - newsAfter * 60000 and ev <= time + newsBefore * 60000
                blk := true
            if fomcPmOff and array.get(evFomc, k) and array.get(evDate, k) == curDate and mod >= 780
                blk := true
    blk

f_newsSoon() =>
    soon = false
    n = array.size(evT)
    if newsOn and newsFlatM > 0 and n > 0
        for k = 0 to n - 1
            ev = array.get(evT, k)
            if ev > time_close and ev <= time_close + newsFlatM * 60000
                soon := true
    soon

// ---------------------------------------------------------------- sweeps -> armed setups
vAvg20 = ta.sma(volume, 20)[1]

if newDay
    lArmed := false
    sArmed := false

if lArmed
    lVrun := math.max(lVrun, volume)
if sArmed
    sVrun := math.max(sVrun, volume)

if array.size(pPx) > 0
    for k = array.size(pPx) - 1 to 0
        px = array.get(pPx, k)
        sd = array.get(pSide, k)
        if sd == -1 and low <= px - tick
            if canArm and not lArmed
                lArmed := true
                lExt := low
                lExtTime := time
                lExtBar := bar_index
                lArmMod := mod
                lVavg := vAvg20
                lVrun := volume
                lVmax := volume
            f_removePool(k)
        else if sd == 1 and high >= px + tick
            if canArm and not sArmed
                sArmed := true
                sExt := high
                sExtTime := time
                sExtBar := bar_index
                sArmMod := mod
                sVavg := vAvg20
                sVrun := volume
                sVmax := volume
            f_removePool(k)

if lArmed and low < lExt
    lExt := low
    lExtTime := time
    lExtBar := bar_index
    lVmax := lVrun
if sArmed and high > sExt
    sExt := high
    sExtTime := time
    sExtBar := bar_index
    sVmax := sVrun
if lArmed and time - lExtTime > expiryMin * 60000
    lArmed := false
if sArmed and time - sExtTime > expiryMin * 60000
    sArmed := false

// ---------------------------------------------------------------- alert messages: bridge JSON or phone text
// Every order carries its message; the one alert ({{strategy.order.alert_message}}) sends it when the order fills.
f_num(float x) =>
    str.tostring(math.round_to_mintick(x), "#.##")

f_px(float x) =>
    str.tostring(math.round_to_mintick(x), "#,##0.00")

f_usd(float x) =>
    "$" + str.tostring(math.round(x), "#,##0")

f_side(int d) =>
    d == 1 ? "LONG" : "SHORT"

f_pos(int d, int q) =>
    f_side(d) + " " + str.tostring(q) + " " + bTicker

f_pmtBase(string data, int q, float px, float sl, float tp, bool updSl) =>
    '{"symbol":"' + bTicker + '","date":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '","data":"' + data
     + '","quantity":' + str.tostring(q) + ',"risk_percentage":0,"price":' + f_num(px) + ',"tp":' + f_num(tp)
     + ',"percentage_tp":0,"dollar_tp":0,"sl":' + f_num(sl) + ',"dollar_sl":0,"percentage_sl":0,"trail":0,"trail_stop":0,"trail_trigger":0,"trail_freq":0'
     + ',"update_tp":false,"update_sl":' + (updSl ? "true" : "false") + ',"token":"' + pmtToken + '","pyramid":false,"same_direction_ignore":true'
     + ',"reverse_order_close":false' + (data == "close" ? ',"full_closed":true' : '') + ',"account_id":"' + pmtAccount + '"}'

// entry: market order with its bracket (stop + target)
f_entryMsg(int d, int q, float st, float tp, float riskD, string sizeNote) =>
    alertFmt == "Phone text" ?
     f_pos(d, q) + " at market · stop " + f_px(st) + " · target " + f_px(tp) + " · risk " + f_usd(riskD) + sizeNote :
     bridge == "TradersPost" ?
     '{"ticker":"' + bTicker + '","action":"' + (d == 1 ? "buy" : "sell") + '","quantity":' + str.tostring(q) + ',"orderType":"market","signalPrice":' + f_num(close)
     + ',"stopLoss":{"type":"stop","stopPrice":' + f_num(st) + '},"takeProfit":{"limitPrice":' + f_num(tp) + '}}' :
     f_pmtBase(d == 1 ? "buy" : "sell", q, close, st, tp, false)

f_why(string reason) =>
    reason == "TIME STOP" ? "time stop: not +0.5R after " + str.tostring(timeStopM) + " min" :
     reason == "GIVEBACK" ? "giveback: was +" + str.tostring(givebackR) + "R, closed back through the entry" :
     reason == "FLAT" ? "end of day: be flat by 15:55" :
     reason == "NEWS FLAT" ? "high-impact news in " + str.tostring(newsFlatM) + " min" : reason

// exit at market: the bot's own rules (time stop, giveback, 15:55 flat, news) or TradingView's bracket fill (reason "bracket";
// as phone text that one only asks you to check the broker, because your own bracket order closes the trade there)
f_exitMsg(string reason, int d, int q) =>
    alertFmt == "Phone text" ?
     (reason == "bracket" ? "STOP OR TARGET HIT · " + f_pos(d, q) + " · check your broker: flat, no orders left" :
     "CLOSE " + f_pos(d, q) + " at market · " + f_why(reason)) :
     bridge == "TradersPost" ?
     '{"ticker":"' + bTicker + '","action":"exit","orderType":"market","cancel":true,"extras":{"reason":"' + reason + '"}}' :
     f_pmtBase("close", q, close, 0.0, 0.0, false)

// TradingView's own stop or target filled (strategy.exit alert_loss / alert_profit)
f_bracketMsg(bool isTarget, int d, int q, float st, float tp, float entryPx) =>
    beStop = not na(entryPx) and (st - entryPx) * d > 0
    alertFmt == "Phone text" ?
     (isTarget ? "TARGET HIT" : beStop ? "BREAKEVEN STOP HIT" : "STOP HIT") + " · " + f_pos(d, q) + " closed at "
     + f_px(isTarget ? tp : st) + " · check your broker: flat, no orders left" :
     f_exitMsg("bracket", d, q)

// breakeven: move the stop (alert() call, once per trade)
f_beMsg(int d, int q, float newStop, float tgt) =>
    alertFmt == "Phone text" ?
     "MOVE STOP to " + f_px(newStop) + " (breakeven) · " + f_pos(d, q) + " · target " + f_px(tgt) + " stays" :
     bridge == "TradersPost" ?
     '{"ticker":"' + bTicker + '","action":"breakeven","orderType":"stop"}' :
     f_pmtBase(d == 1 ? "buy" : "sell", q, close, newStop, tgt, true)

f_sizeNote(bool cold, bool trendHalf) =>
    (cold ? " · half size (cold streak)" : "") + (trendHalf ? " · half size (trending market)" : "")

// ---------------------------------------------------------------- manage the open position (before new entries, like the engine:
// an exit at this close frees the bot to take a new trigger on the same bar)
posNow = strategy.position_size
ctBefore = strategy.closedtrades
jc = false                 // closed at this bar's close by the rules below
jcPnl = 0.0
jcRisk = 0.0
jcQty = 0
if posNow != 0 and strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(strategy.opentrades - 1) == bar_index
    trEntry := strategy.position_avg_price      // first bar in the position: record the fill
    trRisk := math.abs(trEntry - trStop0)
    trBar := bar_index
    trMfe := 0.0
if posNow != 0
    d = posNow > 0 ? 1 : -1
    qx = int(math.abs(posNow))
    fav = d == 1 ? high - trEntry : trEntry - low
    trMfe := math.max(trMfe, trRisk > 0 ? fav / trRisk : 0)
    reason = ""
    if mod >= flatMod or session.islastbar
        reason := "FLAT"
    else if f_newsSoon()
        reason := "NEWS FLAT"
    else if timeStopM > 0 and (bar_index - trBar + 1) * barSecs >= timeStopM * 60 and trMfe < 0.5
        reason := "TIME STOP"
    else if givebackR > 0 and trMfe >= givebackR and (close - trEntry) * d < 0
        reason := "GIVEBACK"
    if reason != ""
        jcPnl := ((close - d * SLIPT * tick) - strategy.position_avg_price) * d * qx * syminfo.pointvalue - 2 * COMM * qx
        jcRisk := math.abs(strategy.position_avg_price - trStop0)
        jcQty := qx
        strategy.close_all(comment=reason, alert_message=f_exitMsg(reason, d, qx), immediately=true)   // fills at this close, like the engine
        jc := true
        if jcPnl > 0
            wonToday := true
    else
        if beAtR > 0 and trMfe >= beAtR
            newStop = d == 1 ? math.max(trStop, trEntry + tick) : math.min(trStop, trEntry - tick)
            if newStop != trStop
                trStop := newStop
                if beModify and not beSent
                    beSent := true
                    alert(f_beMsg(d, qx, newStop, trTgt), alert.freq_once_per_bar_close)
        if d == 1
            strategy.exit("xL", "L", stop=trStop, limit=trTgt, comment_profit="TARGET", comment_loss="STOP",
                 alert_message=f_exitMsg("bracket", d, qx), alert_profit=f_bracketMsg(true, d, qx, trStop, trTgt, trEntry),
                 alert_loss=f_bracketMsg(false, d, qx, trStop, trTgt, trEntry), disable_alert=not syncExits)
        else
            strategy.exit("xS", "S", stop=trStop, limit=trTgt, comment_profit="TARGET", comment_loss="STOP",
                 alert_message=f_exitMsg("bracket", d, qx), alert_profit=f_bracketMsg(true, d, qx, trStop, trTgt, trEntry),
                 alert_loss=f_bracketMsg(false, d, qx, trStop, trTgt, trEntry), disable_alert=not syncExits)

if strategy.closedtrades > lastTrades
    if strategy.closedtrades.profit(strategy.closedtrades - 1) > 0
        wonToday := true
    lastTrades := strategy.closedtrades
jcAdd = jc and strategy.closedtrades == ctBefore ? jcPnl : 0.0     // the exit above, if not yet booked
bal = strategy.initial_capital + strategy.netprofit + jcAdd
dayPnl = strategy.netprofit + jcAdd - dayStartNet                    // realized today, like the engine

// ---------------------------------------------------------------- cold-streak filter (engine/equity_filter.py)
// R of a closed trade = its net result / (entry fill to the stop at entry x contracts x $ per point), 3 decimals.
f_tradeR(int k) =>
    ep = strategy.closedtrades.entry_price(k)
    qk = math.abs(strategy.closedtrades.size(k))
    sk = k < array.size(entStop) ? array.get(entStop, k) : float(na)
    rk = 0.0
    if not na(sk) and qk > 0 and math.abs(ep - sk) > 0
        rk := strategy.closedtrades.profit(k) / (math.abs(ep - sk) * qk * syminfo.pointvalue)
    math.round(rk, 3)

if strategy.closedtrades > coldDone
    for k = coldDone to strategy.closedtrades - 1
        array.push(coldR, f_tradeR(k))
    coldDone := strategy.closedtrades

// sum of the last coldLook R values (the trade closed at this bar's close counts too, if not booked yet)
f_coldState(float extraR) =>
    n = array.size(coldR)
    hasX = not na(extraR)
    tot = n + (hasX ? 1 : 0)
    cnt = math.min(coldLook, tot)
    s = 0.0
    if cnt > 0
        for k = tot - cnt to tot - 1
            s += k < n ? array.get(coldR, k) : extraR
    [math.round(s, 2), cnt]

jcR = jc and strategy.closedtrades == ctBefore and jcRisk > 0 and jcQty > 0 ? math.round(jcPnl / (jcRisk * jcQty * syminfo.pointvalue), 3) : float(na)
[coldSum, coldN] = f_coldState(jcR)
coldNow = coldOn and (coldForce == "Always cold" or (coldForce == "Auto" and coldN >= coldLook and coldSum <= coldMinR))

// ---------------------------------------------------------------- triggers (highest-bar offsets; no lookahead)
// returns [triggered, invLow]  for LONG: first body close above a bearish FVG inside the down-leg
f_trigLong(int extOff) =>
    trig = false
    invLow = float(na)
    // leg origin = highest high in the lookback before the extreme (oldest bar wins ties, like np.argmax)
    legOff = extOff
    hh = high[extOff]
    for j = extOff to extOff + legLook
        if high[j] >= hh
            hh := high[j]
            legOff := j
    bestTop = float(na)
    hasGap = false
    if legOff >= 3
        for j = legOff - 2 to 1
            gTop = low[j + 2]
            gBot = high[j]
            if gTop - gBot >= minFvg
                hasGap := true
                if close > gTop and open < close
                    firstClose = true
                    if j > 1
                        for q = j - 1 to 1
                            if close[q] > gTop
                                firstClose := false
                    if firstClose and (na(bestTop) or gTop < bestTop)
                        bestTop := gTop
                        invLow := math.min(low[j], math.min(low[j + 1], low[j + 2]))
    if not na(bestTop)
        trig := true
    else if not hasGap
        // CISD: close above the open of the first down-close candle of the run that ends at the extreme
        f = extOff
        if close[extOff] < open[extOff]
            while f + 1 < legOff and close[f + 1] < open[f + 1]
                f += 1
        lvl = open[f]
        if close > lvl and open < close
            firstClose = true
            if extOff > 1
                for q = extOff - 1 to 1
                    if close[q] > lvl
                        firstClose := false
            if firstClose
                trig := true
                invLow := low[extOff]
    [trig, invLow]

f_trigShort(int extOff) =>
    trig = false
    invHigh = float(na)
    legOff = extOff
    ll = low[extOff]
    for j = extOff to extOff + legLook
        if low[j] <= ll
            ll := low[j]
            legOff := j
    bestBot = float(na)
    hasGap = false
    if legOff >= 3
        for j = legOff - 2 to 1
            gBot = high[j + 2]
            gTop = low[j]
            if gTop - gBot >= minFvg
                hasGap := true
                if close < gBot and open > close
                    firstClose = true
                    if j > 1
                        for q = j - 1 to 1
                            if close[q] < gBot
                                firstClose := false
                    if firstClose and (na(bestBot) or gBot > bestBot)
                        bestBot := gBot
                        invHigh := math.max(high[j], math.max(high[j + 1], high[j + 2]))
    if not na(bestBot)
        trig := true
    else if not hasGap
        f = extOff
        if close[extOff] > open[extOff]
            while f + 1 < legOff and close[f + 1] > open[f + 1]
                f += 1
        lvl = open[f]
        if close < lvl and open > close
            firstClose = true
            if extOff > 1
                for q = extOff - 1 to 1
                    if close[q] < lvl
                        firstClose := false
            if firstClose
                trig := true
                invHigh := high[extOff]
    [trig, invHigh]

// ---------------------------------------------------------------- sizing (Engine._size, then the cold-streak cut)
// One rule per step, in the engine's order. To add a size rule later: add an input, add one step here (scale riskEff
// before the micros are counted, or cut qty after), and mirror the step in tools/pine_sim.py (plan / size there).
// returns [qty, qtyFull]: contracts to trade, and the size before the cold-streak cut
f_size(float riskPts, float gradeMult, int conv, bool cold) =>
    riskEff = riskUsd
    if ddAware                                  // old rule: cap at a fraction of the cushion above the trailing MLL
        riskEff := math.min(riskEff, math.max(0.0, (bal - mllLvl) * cushionFrac))
    if gradeSizing                              // old rule: A+..D grade multiplier
        riskEff := riskEff * gradeMult
    else if convStep > 0                        // old rule: conviction multiplier
        riskEff := riskEff * math.max(0.5, math.min(1.5, 1 + convStep * conv))
    if refStop > 0 and riskPts > refStop        // wide stop: full risk up to refStop, then risk x refStop / stop
        riskEff := riskEff * (refStop / riskPts)
    if trending and regimeMode == "half"        // trending regime: half size
        riskEff := riskEff * 0.5
    qtyFull = math.min(maxQty, int(math.floor(riskEff / (riskPts * syminfo.pointvalue))))
    qty = qtyFull
    if cold and qtyFull >= 1                    // cold streak: micros x coldMult, at least 1
        qty := math.max(1, int(qtyFull * coldMult))
    [qty, qtyFull]

// ---------------------------------------------------------------- planning: target, score, grade, size
f_q90(int m) =>
    q = 0
    qs = int(na)
    if m >= 360 and m < 720
        q := int((m - 360) / 90) + 1
        qs := 360 + (q - 1) * 90
    else if m >= 720 and m < 1080
        q := int((m - 720) / 90) + 1
        qs := 720 + (q - 1) * 90
    [q, qs]

// returns [ok, stop, target, score, qty, grade, gradePoints, riskPts, qtyFull]
// ok = false: stop too wide, or no major pool >= minRR away (with the fallback target off) -> the setup is consumed
f_plan(int d, float ext, float invX, int armMod, bool climax, bool cold) =>
    entry = close
    stop = ext - d * stopBuf
    risk = (entry - stop) * d
    if risk < minStop
        stop := entry - d * minStop
        risk := minStop
    if risk > maxStop
        alt = invX - d * stopBuf
        altRisk = (entry - alt) * d
        if not na(invX) and altRisk >= minStop and altRisk <= maxStop
            stop := alt
            risk := altRisk
        else
            risk := -1.0
    ok = risk > 0
    target = float(na)
    score = 0
    pts = 0
    qty = 0
    qtyFull = 0
    grade = "D"
    n = array.size(pPx)
    if ok
        // draw on liquidity: nearest MAJOR opposite pool >= minRR
        best = float(na)
        if n > 0
            for k = 0 to n - 1
                px = array.get(pPx, k)
                if array.get(pSide, k) == d and array.get(pMajor, k) and (px - entry) * d >= minRR * risk
                    if na(best) or (px - entry) * d < (best - entry) * d
                        best := px
        if na(best)
            if useFallback
                target := entry + d * fallbackRR * risk
            else
                ok := false                     // no major pool in range: no trade (engine use_fallback false)
        else
            target := (best - entry) * d > maxRR * risk ? entry + d * maxRR * risk : best - d * tick
    if ok
        // confluence score (w_htf 1, w_pd 1, w_lrl 1, w_m15 -1)
        htf = hTrend
        score += htf == d ? 1 : htf == -d ? -1 : 0
        pdv = 0
        if not na(hLsh) and not na(hLsl) and hLsh > hLsl
            ppos = (ext - hLsl) / (hLsh - hLsl)
            pdv := (d == 1 and ppos <= 0.5) or (d == -1 and ppos >= 0.5) ? 1 : -1
        score += pdv > 0 ? 1 : 0
        obst = 0
        if n > 0
            for k = 0 to n - 1
                px = array.get(pPx, k)
                if array.get(pSide, k) == d and array.get(pSwing, k) and (px - entry) * d > 0 and (px - target) * d < 0
                    obst += 1
        lrl = obst <= 1
        hrl = obst >= 3
        score += lrl ? 1 : hrl ? -1 : 0
        m15al = mTrend == d
        score += m15al ? -1 : 0
        // A+..D checklist grade (Engine._grade, non-zero weights only; sizes only with the old grade sizing)
        vw = na(vwap) ? 0 : ((vwap - entry) * d > 0 ? 1 : -1)
        firstHour = mod >= 570 and mod < 630
        pts := (htf == d ? 2 : htf == -d ? -1 : 0) + gPd * pdv + 2 * vw + (climax ? -2 : 0) + (lrl ? 1 : hrl ? -2 : 0)
             + (firstHour ? -1 : 0) + (m15al ? -1 : 0)
        [sQ, sQs] = f_q90(armMod)
        [eQ, eQs] = f_q90(mod)
        pts += sQ == 2 ? 1 : 0
        if not na(eQs)
            qi = int((eQs - 360) / 90)
            if qi >= 0 and qi <= 6
                ref = array.get(qOpen, qi)
                if not na(ref)
                    pts += (ref - ext) * d > 0 ? 1 : -1
        if not na(adr20) and adr20 > 0 and (dHi - dLo) / adr20 >= 1.2
            pts -= 1
        sessStart = mod < 720 ? 570 : 810
        pts -= mod - sessStart < 45 ? gEarly : 0
        pts -= eQ == 3 ? gQ3 : 0
        mult = pts >= 7 ? 1.5 : pts >= 5 ? 1.25 : pts >= 3 ? 1.0 : pts >= 1 ? 0.75 : 0.5
        grade := pts >= 7 ? "A+" : pts >= 5 ? "A" : pts >= 3 ? "B" : pts >= 1 ? "C" : "D"
        conv = (vw > 0 ? 1 : 0) - (climax ? 1 : 0) - (firstHour ? 1 : 0)
        [q1, q2] = f_size(risk, mult, conv, cold)
        qty := q1
        qtyFull := q2
    [ok, stop, target, score, qty, grade, pts, risk, qtyFull]

// ---------------------------------------------------------------- entries
blocked = tradesToday >= maxTrades or dayPnl <= -dayStop or (stopAfterWin and wonToday)
flat = strategy.position_size == 0 or jc
rangeBlock = dayRangeMax > 0 and array.size(dRanges) >= 5 and not na(adr20) and adr20 > 0 and (dHi - dLo) / adr20 >= dayRangeMax
entryBlock = f_newsBlock() or rangeBlock or (trending and regimeMode == "skip")
trendHalf = trending and regimeMode == "half"

if flat and inKZ and mod < flatMod - 10 and not blocked
    if lArmed
        [tg, invL] = f_trigLong(bar_index - lExtBar)
        if tg
            [ok, st, tp, sc, q, gr, gp, rk, qf] = f_plan(1, lExt, invL, lArmMod, lVavg > 0 and lVmax >= 1.5 * lVavg, coldNow)
            if not ok
                lArmed := false                                  // stop too wide / no major draw in range: setup consumed
            else if not entryBlock and sc >= minScore
                if q < 1
                    lArmed := false                              // risk too small for the stop: consumed
                else
                    strategy.entry("L", strategy.long, qty=q, comment="L r=" + str.tostring(rk, "#.##") + " sl=" + f_num(st) + " g=" + gr + (coldNow ? " cold" : ""),
                         alert_message=f_entryMsg(1, q, st, tp, q * rk * syminfo.pointvalue, f_sizeNote(coldNow, trendHalf)))
                    strategy.exit("xL", "L", stop=st, limit=tp, comment_profit="TARGET", comment_loss="STOP",
                         alert_message=f_exitMsg("bracket", 1, q), alert_profit=f_bracketMsg(true, 1, q, st, tp, float(na)),
                         alert_loss=f_bracketMsg(false, 1, q, st, tp, float(na)), disable_alert=not syncExits)
                    array.push(entStop, st)
                    trStop := st
                    trStop0 := st
                    trTgt := tp
                    beSent := false
                    tradesToday += 1
                    label.new(bar_index, low, "L " + str.tostring(q) + (coldNow ? " cold" : "") + " " + gr + " s" + str.tostring(sc), style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.tiny)
                    lArmed := false
                    sArmed := false
    if sArmed
        [tg2, invH] = f_trigShort(bar_index - sExtBar)
        if tg2
            [ok2, st2, tp2, sc2, q2, gr2, gp2, rk2, qf2] = f_plan(-1, sExt, invH, sArmMod, sVavg > 0 and sVmax >= 1.5 * sVavg, coldNow)
            if not ok2
                sArmed := false
            else if not entryBlock and sc2 >= minScore
                if q2 < 1
                    sArmed := false
                else
                    strategy.entry("S", strategy.short, qty=q2, comment="S r=" + str.tostring(rk2, "#.##") + " sl=" + f_num(st2) + " g=" + gr2 + (coldNow ? " cold" : ""),
                         alert_message=f_entryMsg(-1, q2, st2, tp2, q2 * rk2 * syminfo.pointvalue, f_sizeNote(coldNow, trendHalf)))
                    strategy.exit("xS", "S", stop=st2, limit=tp2, comment_profit="TARGET", comment_loss="STOP",
                         alert_message=f_exitMsg("bracket", -1, q2), alert_profit=f_bracketMsg(true, -1, q2, st2, tp2, float(na)),
                         alert_loss=f_bracketMsg(false, -1, q2, st2, tp2, float(na)), disable_alert=not syncExits)
                    array.push(entStop, st2)
                    trStop := st2
                    trStop0 := st2
                    trTgt := tp2
                    beSent := false
                    tradesToday += 1
                    label.new(bar_index, high, "S " + str.tostring(q2) + (coldNow ? " cold" : "") + " " + gr2 + " s" + str.tostring(sc2), style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
                    lArmed := false
                    sArmed := false

// ---------------------------------------------------------------- display
plot(strategy.position_size != 0 ? trStop : na, "Stop", color.red, 1, plot.style_linebr)
plot(strategy.position_size != 0 ? trTgt : na, "Target", color.green, 1, plot.style_linebr)
plot(vwap, "RTH VWAP", color.new(color.orange, 40))
bgcolor(inKZ ? color.new(color.yellow, 92) : na, title="Killzones")
bgcolor(entryBlock and inKZ ? color.new(color.gray, 85) : na, title="News / range / regime block")
plot(hTrend, "1H trend", display=display.data_window)
plot(mTrend, "15m trend", display=display.data_window)
plot(array.size(pPx), "Pools", display=display.data_window)
plot(trending ? 1 : 0, "Trending regime", display=display.data_window)
plot(rollOff, "Roll offset", display=display.data_window)
plot(coldN >= coldLook ? coldSum : na, "Cold streak: R of the last N trades", display=display.data_window)
plot(coldNow ? 1 : 0, "Cold streak: smaller size", display=display.data_window)

var table stBox = table.new(position.top_right, 1, 4, bgcolor=color.new(color.black, 25))
if showTable and barstate.islast
    coldTxt = not coldOn ? "Cold-streak filter: off" :
         coldForce == "Always cold" ? "Cold streak: forced ON - smaller size" :
         coldForce == "Always full size" ? "Cold streak: forced off - full size" :
         coldN < coldLook ? "Cold streak: warming up (" + str.tostring(coldN) + "/" + str.tostring(coldLook) + " closed trades) - full size" :
         "Last " + str.tostring(coldLook) + " trades: " + (coldSum > 0 ? "+" : "") + str.tostring(coldSum, "#.##") + "R - " + (coldNow ? "COLD, half size" : "full size")
    table.cell(stBox, 0, 0, "Liquidity Engine " + VERSION, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stBox, 0, 1, "Risk " + f_usd(riskUsd) + " up to a " + str.tostring(refStop) + "-pt stop · " + str.tostring(maxTrades) + " trade/day", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stBox, 0, 2, coldTxt, text_color=coldNow ? color.orange : color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stBox, 0, 3, "Today: " + str.tostring(tradesToday) + " trade(s)" + (trendHalf ? " · trending market: half size" : "") + (alertFmt == "Phone text" ? " · alerts: phone text" : " · alerts: " + bridge + " JSON"), text_color=color.white, text_size=size.small, text_halign=text.align_left)
