+// ===== PULSE: the trading clock, today's one thing, money this month (+ quick add), close the day (ext-pulse.js; docs/features-pulse.md; tests/pulse.test.js) =====
+// (2026-11-04, owner: "more useful, money first, plain words")
+//  - Trading clock: where the New York session is (the bots' entry window 02:00-15:30 ET, the NY open 09:30, flat 15:55) as a ring, the time to the next
+//    milestone, weekends, and the bots' last live status (device copy planner.ext.live, READ ONLY).
+//  - Today's one thing: pick the one task that makes the day a win; a big tick completes it through the Planner's own commit (Undo works).
+//  - Money this month: in, out and net against the same days last month, six months of net as bars, the net by project, and a two-tap quick add
+//    (money in / money out) written through snapshot() + commit() like the app's own money log.
+//  - Close the day: tasks done, focus minutes, habits, money, the bots' status in a few plain lines; Copy, or Save to today's journal (appended).
+// Loaded in <head>; waits for 'planner:ready'. Own data: the device key planner.pulse.one ({ day, id }); nothing is synced. Follows the Olympus layer (--ox-a, --ox-b).
+(function () {
+  'use strict';
+  let A = null, wanted = '', dlg = null, tick = 0, form = '';
+  const get = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
+  const set = (k, v) => { try { localStorage.setItem(k, v); } catch (e) { /* private mode: this visit only */ } };
+  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  const p2 = (n) => String(n).padStart(2, '0');
+  const kOf = (d) => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
+  const today = () => kOf(new Date());
+  const usd = (v, sign) => { const x = Math.round(Math.abs(v) * 100) / 100, s = '$' + x.toLocaleString('en-US', { minimumFractionDigits: x % 1 ? 2 : 0, maximumFractionDigits: 2 }); return v < -0.004 ? '-' + s : sign && v > 0.004 ? '+' + s : s; };
+  const dur = (m) => { m = Math.max(0, Math.round(m)); return m >= 60 ? `${Math.floor(m / 60)}h${m % 60 ? ' ' + (m % 60) + 'm' : ''}` : `${m}m`; };
+  const isOpen = (x) => !!x && !x.done && x.tag !== 'idea' && !/^Idea:/.test(x.title || '');
+  const est = (x) => (+x.est > 0 ? +x.est : 30);
+  const ONE_KEY = 'planner.pulse.one';
+
+  // =====================================================================================================================
+  // Pure helpers (also on window.__pu for the tests)
+  // =====================================================================================================================
+  // The New York session: [from, to, open, flat] in minutes of the ET day (STRATEGY.md: entries 02:00-15:30, flat 15:55, the NY open 09:30)
+  const WIN = { from: 2 * 60, to: 15 * 60 + 30, open: 9 * 60 + 30, flat: 15 * 60 + 55 };
+  function etNow(ms) {
+    try {
+      const o = {}; for (const x of new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hourCycle: 'h23', weekday: 'short', hour: '2-digit', minute: '2-digit' }).formatToParts(new Date(ms))) o[x.type] = x.value;
+      return { min: (+o.hour % 24) * 60 + +o.minute, wd: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(o.weekday) };
+    } catch (e) { const d = new Date(ms); return { min: d.getUTCHours() * 60 + d.getUTCMinutes(), wd: d.getUTCDay() }; }
+  }
+  // sessionClock(etMin, wd) -> { phase, label, next: { name, mins } | null, frac (0..1 of 02:00-15:55), live: bool }
+  function sessionClock(min, wd) {
+    const span = WIN.flat - WIN.from;
+    if (wd === 0 || wd === 6) return { phase: 'weekend', label: 'No session today', next: { name: wd === 0 ? 'the Sunday evening open' : 'Monday 02:00 ET', mins: null }, frac: 0, live: false };
+    if (min < WIN.from) return { phase: 'before', label: 'Before the window', next: { name: 'the entry window opens (02:00 ET)', mins: WIN.from - min }, frac: 0, live: false };
+    if (min < WIN.open) return { phase: 'window', label: 'Window open, before the NY open', next: { name: 'the NY open (09:30 ET)', mins: WIN.open - min }, frac: (min - WIN.from) / span, live: true };
+    if (min < WIN.to) return { phase: 'open', label: 'Window open, the NY session is on', next: { name: 'the last entry (15:30 ET)', mins: WIN.to - min }, frac: (min - WIN.from) / span, live: true };
+    if (min < WIN.flat) return { phase: 'flat', label: 'No new entries: flat at 15:55', next: { name: 'flat (15:55 ET)', mins: WIN.flat - min }, frac: (min - WIN.from) / span, live: true };
+    return { phase: 'after', label: 'The bots are flat for the day', next: { name: 'tomorrow 02:00 ET', mins: 1440 - min + WIN.from }, frac: 1, live: false };
+  }
+  const left = (m) => (m == null ? '' : m < 60 ? `${Math.max(1, Math.round(m))} min` : `${Math.floor(m / 60)} h ${Math.round(m % 60)} min`);
+
+  // moneyMonth(rows, todayKey, projName) -> { month: { in, out, net, n }, prev: { in, out, net } (the same days of last month), bars: [{ m, net }] (6 months, oldest first), byProj: [{ name, net }], topOut: [{ note, amt }] }
+  function moneyMonth(rows, t, projName) {
+    const ok = (rows || []).filter((m) => m && /^\d{4}-\d{2}-\d{2}$/.test(m.date || '') && (m.kind === 'in' || m.kind === 'out') && +m.amt > 0);
+    const ym = t.slice(0, 7), day = +t.slice(8, 10), py = +ym.slice(0, 4), pm = +ym.slice(5, 7);
+    const prevYm = pm === 1 ? `${py - 1}-12` : `${py}-${p2(pm - 1)}`;
+    const sum = (list) => { const i = list.filter((m) => m.kind === 'in').reduce((a, m) => a + +m.amt, 0), o = list.filter((m) => m.kind === 'out').reduce((a, m) => a + +m.amt, 0); return { in: Math.round(i * 100) / 100, out: Math.round(o * 100) / 100, net: Math.round((i - o) * 100) / 100, n: list.length }; };
+    const cur = ok.filter((m) => m.date.slice(0, 7) === ym && m.date <= t), prev = ok.filter((m) => m.date.slice(0, 7) === prevYm && +m.date.slice(8, 10) <= day);
+    const bars = []; let y = py, mo = pm;
+    for (let i = 0; i < 6; i++) { const key = `${y}-${p2(mo)}`; bars.unshift({ m: key, net: sum(ok.filter((m) => m.date.slice(0, 7) === key)).net }); mo--; if (mo === 0) { mo = 12; y--; } }
+    const pj = new Map(); cur.forEach((m) => { const n = (m.proj && projName ? projName(m.proj) : '') || 'Untagged'; pj.set(n, (pj.get(n) || 0) + (m.kind === 'in' ? +m.amt : -m.amt)); });
+    return { month: sum(cur), prev: sum(prev), bars, byProj: [...pj.entries()].map(([name, net]) => ({ name, net: Math.round(net * 100) / 100 })).sort((a, b) => Math.abs(b.net) - Math.abs(a.net)).slice(0, 4),
+      topOut: cur.filter((m) => m.kind === 'out').sort((a, b) => +b.amt - +a.amt).slice(0, 3).map((m) => ({ note: String(m.note || 'No note').slice(0, 40), amt: +m.amt })) };
+  }
+
+  // suggestOne(tasks, t) -> up to 4 open tasks for today (overdue first, then priority, then the shortest that is still worth a day)
+  function suggestOne(tasks, t) {
+    return (tasks || []).filter((x) => isOpen(x) && x.date && x.date <= t).sort((a, b) => (a.date < t ? 0 : 1) - (b.date < t ? 0 : 1) || (b.p || 0) - (a.p || 0) || est(b) - est(a)).slice(0, 4);
+  }
+
+  // closeText({ day, done, open, focus, habits, habitsOf, in, out, bots }) -> the lines of the close-the-day note
+  function closeLines(o) {
+    const L = [`Day close, ${o.day}`];
+    L.push(`Tasks: ${o.done} done, ${o.open} still open.`);
+    L.push(`Focus: ${o.focus ? dur(o.focus) : 'none logged'}.`);
+    if (o.habitsOf) L.push(`Habits: ${o.habits} of ${o.habitsOf} checked.`);
+    if (o.in || o.out) L.push(`Money today: ${usd(o.in)} in, ${usd(o.out)} out (${usd(o.in - o.out, true)}).`);
+    if (o.bots) L.push(`Bots: ${o.bots}.`);
+    if (o.one) L.push(`The one thing: ${o.one.title}, ${o.one.done ? 'done' : 'not done'}.`);
+    return L;
+  }
+
+  // =====================================================================================================================
+  // The app's data
+  // =====================================================================================================================
+  const projName = (id) => { const p = (A.S.projects || []).find((x) => x && x.id === id); return p ? p.name || p.title || '' : ''; };
+  function liveBots() {
+    try {
+      const c = JSON.parse(get('planner.ext.live') || 'null'), v = c && c.v;
+      if (!v) return null;
+      const accts = [v.lit, v.atlas, v.blitz].filter(Boolean), room = accts.reduce((m, a) => (a && a.roomFrac != null ? Math.min(m, a.roomFrac) : m), 1);
+      return { running: v.running === true ? true : v.running === false ? false : null, label: v.verdict && v.verdict.label ? String(v.verdict.label).slice(0, 30) : '', reason: v.verdict && v.verdict.reason ? String(v.verdict.reason).slice(0, 80) : '', pos: accts.some((a) => a && a.pos && a.pos.qty), room: accts.some((a) => a && a.roomFrac != null) ? room : null };
+    } catch (e) { return null; }
+  }
+  const oneRec = () => { try { const o = JSON.parse(get(ONE_KEY) || 'null'); return o && o.day === today() && o.id ? o : null; } catch (e) { return null; } };
+  const oneTask = () => { const o = oneRec(); return o ? (A.S.tasks || []).find((x) => x && x.id === o.id) || null : null; };
+  function closeInfo() {
+    const t = today(), S = A.S, done = S.tasks.filter((x) => x && x.done && x.doneAt && kOf(new Date(x.doneAt)) === t).length, open = S.tasks.filter((x) => isOpen(x) && x.date && x.date <= t).length;
+    const focus = S.tasks.reduce((a, x) => a + (x && x.fl && +x.fl[t] > 0 ? +x.fl[t] : 0), 0), hs = (S.habits || []).filter((h) => h && (h.name || h.title));
+    const today$ = S.money.filter((m) => m && m.date === t), b = liveBots(), one = oneTask();
+    return { day: t, done, open, focus, habits: hs.filter((h) => Array.isArray(h.done) && h.done.includes(t)).length, habitsOf: hs.length,
+      in: today$.filter((m) => m.kind === 'in').reduce((a, m) => a + (+m.amt || 0), 0), out: today$.filter((m) => m.kind === 'out').reduce((a, m) => a + (+m.amt || 0), 0),
+      bots: b ? [b.label || (b.running === false ? 'stopped' : 'running'), b.room != null ? `eval room ${Math.round(b.room * 100)}%` : ''].filter(Boolean).join(', ') : '', one: one ? { title: one.title || 'Task', done: !!one.done } : null };
+  }
+
+  // =====================================================================================================================
+  // The sheet
+  // =====================================================================================================================
+  function clockHtml() {
+    const e = etNow(Date.now()), c = sessionClock(e.min, e.wd), b = liveBots(), C = 2 * Math.PI * 46;
+    const ring = `<svg class="pu-ring" viewBox="0 0 110 110" role="img" aria-label="${esc(c.label)}"><circle cx="55" cy="55" r="46" class="trk"/><circle cx="55" cy="55" r="46" class="arc ${c.live ? 'live' : ''}" style="stroke-dasharray:${(C * Math.max(0.02, c.frac)).toFixed(1)} ${C.toFixed(1)}"/>`
+      + `<text x="55" y="52" text-anchor="middle" class="t1">${esc(p2(Math.floor(e.min / 60)))}:${esc(p2(e.min % 60))}</text><text x="55" y="68" text-anchor="middle" class="t2">NEW YORK</text></svg>`;
+    const note = b ? [b.running === false ? 'The bots look stopped' + (b.reason ? ': ' + b.reason : '') + '.' : b.label ? `Bots: ${b.label}.` : '', b.pos ? 'A bot is in a trade right now.' : '', b.room != null && b.room < 0.25 ? 'Eval room is thin: a hands-off day.' : b.room != null ? `Eval room ${Math.round(b.room * 100)}% left.` : ''].filter(Boolean)
+      : ['No live bot status on this phone yet (open Bots and projects once).'];
+    return `<div class="pu-clock">${ring}<div><b class="pu-big">${esc(c.label)}</b>${c.next ? `<p>${c.next.mins != null ? `${esc(left(c.next.mins))} to ${esc(c.next.name)}` : esc(c.next.name)}</p>` : ''}${note.map((n) => `<p class="pu-sm${/stopped|thin|trade/.test(n) ? ' warn' : ''}">${esc(n)}</p>`).join('')}</div></div>`;
+  }
+  function oneHtml() {
+    const t = oneTask();
+    if (t) {
+      return `<div class="pu-one${t.done ? ' done' : ''}"><button type="button" class="pu-tick" data-pu="one-tick" aria-pressed="${!!t.done}" aria-label="${t.done ? 'Mark not done' : 'Mark done'}: ${esc(t.title)}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg></button>`
+        + `<div><b>${esc(t.title || 'Task')}</b><small>${t.done ? 'Done. The day is already a win.' : `about ${esc(dur(est(t)))} · the one thing for today`}</small></div></div><div class="pu-acts"><button type="button" class="pu-b" data-pu="one-change">Change it</button></div>`;
+    }
+    const sug = suggestOne(A.S.tasks, today());
+    if (!sug.length) return '<p class="pu-sm">No open task for today. Add one, then pick the one that makes today a win.</p>';
+    return '<p class="pu-sm">If you only finish one thing today, what is it?</p>' + sug.map((x) => `<button type="button" class="pu-pick" data-pu="one-pick" data-id="${esc(x.id)}"><b>${esc(x.title || 'Task')}</b><small>${x.date < today() ? 'overdue · ' : ''}about ${esc(dur(est(x)))}${(x.p || 0) >= 2 ? ' · high priority' : ''}</small></button>`).join('');
+  }
+  function moneyHtml() {
+    const M = moneyMonth(A.S.money, today(), projName), mx = Math.max(1, ...M.bars.map((b) => Math.abs(b.net)));
+    const d = M.month.net - M.prev.net, none = !M.month.n && !M.prev.n && M.bars.every((b) => !b.net);
