+  }
+  function closeHtml() {
+    const lines = closeLines(closeInfo());
+    return `<ul class="pu-lines">${lines.map((l, i) => `<li${i ? '' : ' class="h"'}>${esc(l)}</li>`).join('')}</ul><div class="pu-acts"><button type="button" class="pu-b go" data-pu="close-copy">Copy</button><button type="button" class="pu-b" data-pu="close-save">Save to my journal</button></div><p class="pu-sm" id="puMsg" role="status"></p>`;
+  }
+  function paint(force) {
+    if (!dlg) return;
+    dlg.querySelector('#puClock').innerHTML = clockHtml();
+    dlg.querySelector('#puOne').innerHTML = oneHtml();
+    if (force || !dlg.contains(document.activeElement) || !document.activeElement.closest('.pu-form')) dlg.querySelector('#puMoney').innerHTML = moneyHtml();
+    dlg.querySelector('#puClose').innerHTML = closeHtml();
+    const sub = dlg.querySelector('#puSub'); if (sub) sub.textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
+  }
+  function msg(t) { const m = dlg && dlg.querySelector('#puMsg'); if (m) m.textContent = t; try { A.toast(t); } catch (e) { /* the line stays */ } }
+  function open(where) {
+    if (!dlg) {
+      document.body.insertAdjacentHTML('beforeend', `<dialog id="puPulse" class="pu" aria-label="Pulse"><div class="pu-bg" aria-hidden="true"><i></i><i></i></div>
+        <button type="button" class="pu-x" data-pu="close" aria-label="Close Pulse"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
