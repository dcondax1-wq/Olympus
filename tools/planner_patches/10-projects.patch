+// Planner add-on: your projects, live (planner/ext-projects.js). Loaded by one <script defer> tag in index.html and talks to the
+// app only through window.PLANNER_EXT (the EXT block in index.html). Docs: docs/features-projects.md. Tests: tests/projects.test.js.
+// - "Bots and projects" on Today: the NQ bots (Zlarior, ATLAS, BLITZ) from the PC's live.json, the Kalshi bot from kalshi.json,
+//   the NQ market clock, project health, and one-tap links to Zenith, Kalshi and Jarvis. It only jumps to "Needs you now" when a
+//   bot is stopped or silent inside its own trading window (02:00-15:30 ET on weekdays), and that can be switched off.
+// - Projects view: health at a glance for every project, and a live line on each project that has a dashboard.
+// - Market hours: CME NQ (Sun 6pm to Fri 5pm ET, daily break 5-6pm) and the bots' window, optional bands on the Day and Week
+//   views (off until switched on). Nothing is ever added to the calendar data.
+// - Jarvis: localStorage 'planner.today.v1' = { v: 1, day, events: [{ title, start, end, allDay }], tasks: [{ title, due, done }],
+//   updated } is rewritten whenever the day's events or tasks change, so Jarvis can read the day whatever the planner's own format.
+// Storage, this device only (never synced or backed up): planner.ext.projects (settings), planner.ext.live and planner.ext.kalshi
+// (the last good copies, for offline), planner.today.v1. The planner's own data (planner.v1 and the rest) is only ever read.
+(() => {
+  'use strict';
+  const OWNER = 'demetrades2000-coder', REPO = 'nq-dashboard';
+  const FEEDS = {
+    nq: { raw: `https://raw.githubusercontent.com/${OWNER}/${REPO}/live/live.json`, api: `https://api.github.com/repos/${OWNER}/${REPO}/contents/live.json?ref=live` },
+    kalshi: { raw: `https://raw.githubusercontent.com/${OWNER}/kalshi-feed/main/kalshi.json`, api: `https://api.github.com/repos/${OWNER}/kalshi-feed/contents/kalshi.json?ref=main` }, // its own repo
+  };
+  const SITE = `https://${OWNER}.github.io/${REPO}/`;
+  const CFG_KEY = 'planner.ext.projects', TODAY_KEY = 'planner.today.v1', CACHE = { nq: 'planner.ext.live', kalshi: 'planner.ext.kalshi' };
+  const DEF = { nq: true, kalshi: true, flag: true, bands: false };
+  const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+  const BOT_ON = 120, BOT_OFF = 930, CME_CLOSE = 1020, CME_OPEN = 1080; // ET minutes: 02:00, 15:30, 17:00, 18:00
+  const STALE_S = 20 * 60; // the PC publishes every 5 minutes; 20 minutes without a new copy = not updating
+
+  function start(api) {
+    if (window.__xpStarted) return; window.__xpStarted = true;
+    const esc = (s) => api.esc(s);
+    const rd = (k) => { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };
+    const wr = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } };
+    const cfg = () => { const c = rd(CFG_KEY); return { ...DEF, ...(c && typeof c === 'object' ? c : {}) }; };
+    const setCfg = (patch) => { wr(CFG_KEY, { ...cfg(), ...patch }); };
+    const num = (v) => (v == null || v === '' || !Number.isFinite(+v) ? null : +v);
+    const str = (v, n) => (v == null ? '' : String(v).replace(/\s+/g, ' ').trim().slice(0, n));
+    const squash = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9]/g, '');
+    const nowS = () => Date.now() / 1000;
+    const onSite = /^https?:$/.test(location.protocol) && /\/planner\/(index\.html)?$/.test(location.pathname);
+    // The other dashboards live next to the planner on the same site (relative links); anywhere else, on the public site.
+    const LINKS = onSite ? { zenith: '../', kalshi: '../kalshi/', jarvis: '../jarvis/' } : { zenith: SITE, kalshi: SITE + 'kalshi/', jarvis: SITE + 'jarvis/' };
+    // Opened inside Jarvis (a frame on the same site whose page has window.__jarvis): Jarvis switches to the other app itself, so
+    // nothing reloads and Jarvis stays around it. Anywhere else the link opens normally, in this tab.
+    const APP = { zenith: 'zenith', kalshi: 'kalshi', jarvis: 'home' };
+    function jarvisHost() {
+      try {
+        if (window.top === window.self || !window.parent || window.parent === window || window.parent.location.origin !== location.origin) return null;
+        const j = window.parent.__jarvis;
+        return j && typeof j.show === 'function' ? j : null;
+      } catch (e) { return null; } // a frame from another site: not Jarvis
+    }
+    const NAMES = { zenith: 'Zenith', kalshi: 'Kalshi', jarvis: 'Jarvis' };
+    const label = (k) => (k === 'jarvis' && jarvisHost() ? 'Back to Jarvis' : NAMES[k]);
+    const linkBtn = (k, cls = 'btn sm') => `<a class="${cls}" href="${esc(LINKS[k])}" data-xpgo="${k}">${esc(label(k))} <span aria-hidden="true">↗</span></a>`;
+    function go(k) {
+      const j = jarvisHost();
+      if (j) { try { j.show(APP[k]); return; } catch (e) { /* Jarvis could not switch: open the page instead */ } }
+      try { location.href = new URL(LINKS[k], location.href).href; } catch (e) { /* nothing to open */ }
+    }
+
+    // ---------- money and time words ----------
+    function money(v, sign, whole) {
+      const x = num(v); if (x == null) return '—';
+      const a = whole ? Math.round(Math.abs(x)) : Math.abs(x), cents = !whole && a > 0 && a < 1000 && Math.round(a) !== a;
+      return (x < 0 ? '-' : sign && x > 0 ? '+' : '') + '$' + a.toLocaleString('en-US', { minimumFractionDigits: cents ? 2 : 0, maximumFractionDigits: cents ? 2 : 0 });
+    }
+    const pnlCls = (v) => (num(v) > 0 ? 'pos' : num(v) < 0 ? 'neg' : '');
+    const ago = (t) => { if (!t) return ''; const s = Math.max(0, nowS() - t); return s < 90 ? 'just now' : s < 3600 ? Math.round(s / 60) + ' min ago' : s < 86400 ? Math.round(s / 3600) + ' h ago' : Math.round(s / 86400) + (s < 172800 ? ' day ago' : ' days ago'); };
+    function inTxt(ms, from) {
+      const m = Math.max(1, Math.round((ms - (from == null ? Date.now() : from)) / 60000));
+      if (m < 60) return `in ${m} min`;
+      const h = Math.floor(m / 60), r = m % 60;
+      if (h < 24) return `in ${h} h${r ? ' ' + r + ' min' : ''}`;
+      const d = Math.floor(h / 24), hh = h % 24; return `in ${d} day${d === 1 ? '' : 's'}${hh ? ' ' + hh + ' h' : ''}`;
+    }
+
+    // ---------- market hours (CME NQ and the bots' window), worked out in New York time ----------
+    const etDow = (day) => { const [y, m, d] = day.split('-').map(Number); return new Date(Date.UTC(y, m - 1, d)).getUTCDay(); };
+    // ET wall time (day, minutes) -> ms, through the planner's own ET converter (daylight saving included)
+    function etMs(day, min) {
+      const r = api.etToLocal(day, api.fromMin(min)), [h, mi] = r.hm.split(':').map(Number), d = api.parse(r.date);
+      d.setHours(h, mi, 0, 0); return d.getTime();
+    }
+    // open: CME NQ trades now; halt: the 5-6pm ET daily break (Mon-Thu); bots: inside the bots' entry window. Next changes with times.
+    function market(ms) {
+      const at = ms == null ? Date.now() : ms, et = api.mnEt(at), wd = et.wd, m = et.min;
+      const open = wd === 6 ? false : wd === 0 ? m >= CME_OPEN : wd === 5 ? m < CME_CLOSE : !(m >= CME_CLOSE && m < CME_OPEN);
+      const halt = wd >= 1 && wd <= 4 && m >= CME_CLOSE && m < CME_OPEN;
+      const bots = wd >= 1 && wd <= 5 && m >= BOT_ON && m < BOT_OFF;
+      const ev = [];
+      for (let i = 0; i < 9; i++) {
+        const day = i ? api.addDays(et.day, i) : et.day, w = etDow(day);
+        const add = (min, kind) => { if (i > 0 || min > m) ev.push({ day, min, kind, w }); };
+        if (w === 0) add(CME_OPEN, 'open');
+        if (w >= 1 && w <= 4) { add(CME_CLOSE, 'close'); add(CME_OPEN, 'open'); }
+        if (w === 5) add(CME_CLOSE, 'close');
+        if (w >= 1 && w <= 5) { add(BOT_ON, 'on'); add(BOT_OFF, 'off'); }
+      }
+      ev.sort((a, b) => a.day.localeCompare(b.day) || a.min - b.min);
+      const next = (k) => { const e = ev.find((x) => x.kind === k); return e ? { ...e, ms: etMs(e.day, e.min) } : null; };
+      return { at, et, open, halt, weekend: !open && !halt, bots, nextOpen: next('open'), nextClose: next('close'), botsOn: next('on'), botsOff: next('off') };
+    }
+    // "6pm ET", "Mon 2am ET", "tomorrow 2am ET" (+ the phone's own time when it is not on New York time)
+    function whenTxt(x, et) {
+      const pre = x.day === et.day ? '' : x.day === api.addDays(et.day, 1) ? 'tomorrow ' : WD[x.w] + ' ';
+      const d = new Date(x.ms), loc = api.localIsET() ? '' : `, ${api.fmtTime(`${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`)} your time`;
+      return `${pre}${api.fmtTime(api.fromMin(x.min))} ET${loc}`;
+    }
+    function marketLine(mk) {
+      const et = mk.et, w = (x) => `${whenTxt(x, et)} (${inTxt(x.ms, mk.at)})`;
+      if (mk.halt) return { lvl: 'warn', text: `CME daily break. NQ reopens ${w(mk.nextOpen)}` };
+      if (!mk.open) return { lvl: 'idle', text: `NQ closed for the weekend. Opens ${w(mk.nextOpen)}` };
+      if (mk.bots) return { lvl: 'ok', text: `NQ open. Bots' window open until ${w(mk.botsOff)}` };
+      return { lvl: 'ok', text: `NQ open. Bots' window opens ${w(mk.botsOn)}` };
+    }
+    const marketShort = (mk) => (mk.halt ? 'CME break' : !mk.open ? 'NQ closed' : mk.bots ? "NQ open, bots' window open" : 'NQ open');
+
+    // ---------- the live feeds ----------
+    // What the cards need from live.json, mirroring Zenith and Jarvis (board.lit / board.atlas / board.blitz, pc_verdict).
+    function slim(j) {
+      if (!j || typeof j !== 'object' || !j.board || typeof j.board !== 'object') return null;
+      const b = j.board;
+      const bz = b.blitz && !b.blitz.error ? b.blitz : j.blitz && typeof j.blitz === 'object' && !j.blitz.error ? j.blitz : null;
+      const acct = (x) => (x && typeof x === 'object' ? {
+        name: str(x.name, 40), plan: str(x.plan, 60), badge: str(x.badge, 16), status: str(x.status, 40), off: !!x.off,
+        today: num(x.today_pnl), week: num(x.week_pnl), room: num(x.room), roomFrac: num(x.room_frac), toTarget: num(x.to_target),
+        balance: num(x.balance), session: num(x.session), sessions: num(x.sessions), trades: num(x.trades_today),
+        pos: x.position && typeof x.position === 'object' ? { side: str(x.position.side, 8), qty: num(x.position.qty) } : null,
+        win: x.window && typeof x.window === 'object' ? { open: !!x.window.open, text: str(x.window.text, 80) } : null,
+      } : null);
+      const vd = j.pc_verdict && typeof j.pc_verdict === 'object' ? j.pc_verdict : null;
+      return {
+        t: num(j.t) || num(b.t) || 0, running: b.running === true,
+        verdict: vd ? { label: str(vd.label, 80), level: str(vd.level, 10), reason: str(vd.reason, 160) } : null,
+        lit: acct(b.lit), atlas: acct(b.atlas), blitz: acct(bz),
+        lines: (Array.isArray(b.lines) ? b.lines : []).slice(0, 4).map((l) => ({ level: str(l && l.level, 10), text: str(l && l.text, 240) })).filter((l) => l.text),
+        windows: (b.lit && Array.isArray(b.lit.windows) ? b.lit.windows : []).slice(0, 3).map((w) => ({ label: str(w && w.label, 40) })).filter((w) => w.label),
+      };
+    }
+    // What the cards need from kalshi.json (balance, today_pnl, positions ...)
+    function kslim(j) {
+      if (!j || typeof j !== 'object' || Array.isArray(j)) return null;
+      return { t: num(j.t) || 0, running: j.running === false ? false : j.running === true ? true : null, mode: str(j.mode, 12),
+        balance: num(j.balance), today: num(j.today_pnl), open: Array.isArray(j.positions) ? j.positions.length : num(j.open_positions) };
+    }
+    // F[src] = { c: last good copy { at, v } (also in localStorage), at: last try, ok: last try worked, okAt, state, busy }
+    const F = {};
+    for (const k of ['nq', 'kalshi']) { const c = rd(CACHE[k]); F[k] = { c: c && c.v && typeof c.v === 'object' ? c : null, at: 0, ok: null, okAt: 0, state: '', busy: false, apiUntil: 0 }; }
+    async function timed(url, opts, ms = 8000) {
+      const ac = typeof AbortController === 'function' ? new AbortController() : null, t = setTimeout(() => ac && ac.abort(), ms);
+      try { return await fetch(url, { ...opts, cache: 'no-cache', signal: ac ? ac.signal : undefined }); } finally { clearTimeout(t); }
+    }
+    // Raw file first (no rate limit), the GitHub API as a fallback. 404 = not published yet. Never throws, never toasts.
+    async function pull(k) {
+      const f = F[k], feed = FEEDS[k];
+      if (f.busy) return false;
+      f.busy = true; f.at = Date.now();
+      let j = null, st = -1;
+      try { const r = await timed(feed.raw + '?t=' + Math.floor(Date.now() / 60000)); st = r.status; if (r.ok) j = await r.json(); } catch (e) { j = null; }
+      if (!j && st !== 404 && Date.now() > f.apiUntil) {
+        try {
+          const r = await timed(feed.api, { headers: { Accept: 'application/vnd.github.raw+json' } });
+          if (r.ok) j = await r.json();
+          else if (r.status === 404) st = 404;
+          else if (r.status === 403 || r.status === 429) f.apiUntil = Date.now() + 15 * 60e3; // rate limited: raw only for a while
+        } catch (e) { /* offline: keep the last copy */ }
+      }
+      f.busy = false;
+      const v = j ? (k === 'nq' ? slim(j) : kslim(j)) : null;
+      const before = JSON.stringify(f.c && f.c.v), was = f.state;
+      if (v) {
+        f.ok = true; f.okAt = Date.now(); f.state = 'ok';
+        if (!f.c || (v.t || 0) >= (f.c.v.t || 0)) { f.c = { at: Date.now(), v }; wr(CACHE[k], f.c); }
+      } else { f.ok = false; f.state = st === 404 ? 'waiting' : 'error'; if (st === 404) f.okAt = Date.now(); }
+      return JSON.stringify(f.c && f.c.v) !== before || f.state !== was;
+    }
+    async function refresh(force) {
+      const c = cfg(), jobs = [];
+      for (const k of ['nq', 'kalshi']) if (c[k] && (force || Date.now() - F[k].at > 60e3)) jobs.push(pull(k));
+      if (!jobs.length) return null;
+      const changed = (await Promise.all(jobs)).some(Boolean);
+      if (changed) { if (api.view() === 'today' || api.view() === 'projects') api.render(); paintSheet(); } // other screens pick it up on their next draw
+      return changed;
+    }
+    const live = () => (cfg().nq && F.nq.c ? F.nq.c.v : null);
+    const kal = () => (cfg().kalshi && F.kalshi.state !== 'waiting' && F.kalshi.c ? F.kalshi.c.v : null);
+
+    // ---------- states ----------
+    // The NQ bots as one state: ok / warn / bad / idle, a short word for the summary line and whether the feed went quiet.
+    function nqState(v, mk) {
