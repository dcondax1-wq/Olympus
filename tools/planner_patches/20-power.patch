+  function datesIn(s, t) {
+    let m, date = '', day = 0;
+    const cut = (x) => { s = s.slice(0, x.index) + ' ' + s.slice(x.index + x[0].length); };
+    if ((m = s.match(MD_RE)) && (date = mdDate(t, monthIdx(m[2]), +m[3], m[4]))) { day = +m[3]; cut(m); }
