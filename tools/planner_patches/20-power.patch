+    else if (ap1) { s = h24(h1, ap1) * 60 + mi1; e = h24(h2, ap1) * 60 + mi2; if (e <= s) e = h24(h2, flip(ap1)) * 60 + mi2; }
+    else { const g = (h) => (h >= 1 && h <= 6 ? h + 12 : h); s = g(h1) * 60 + mi1; e = g(h2) * 60 + mi2; if (e <= s && e + 720 <= 1440) e += 720; }
+    if (e <= s) e = 1440; // runs past midnight: shown until the end of the day
