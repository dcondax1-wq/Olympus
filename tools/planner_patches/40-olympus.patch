+    const X = window.__ox;
+    const lv = [X.level(null, null, false), X.level('off', 'high', false), X.level(null, 'off', false), X.level(null, 'low', false), X.level(null, null, true)];
+    const th = [X.themeVars({ accent: '#f7c948', accent2: '#ff7a1a' }), X.themeVars(JSON.stringify({ name: 'sea', tokens: { accent: 'rgb(0, 150, 255)' } })),
+      X.themeVars({ vars: { '--oly-accent': '#abc', glow: 'red; x:y' } }), X.themeVars('gold'), X.themeVars(null), X.themeVars({ accent: 'url(x)' })];
+    const ln = X.line([{ id: 'a', s: 420, e: 930 }, { id: 'b', s: 840, e: 900 }, { id: 'c', s: 960, e: 1320 }, { id: 'd', s: 990, e: 1050 }, { id: 'bad', s: 600, e: 600 }], 750);
+    const late = X.line([{ id: 'x', s: 360, e: 1410 }], 100);
+    const s = [X.state({ status: 'run', start: 0, min: 25 }, null, 5 * 60000), X.state(null, { end: 210000, min: 5 }, 60000), X.state({ status: 'done', min: 25 }, null, 0), X.state(null, { end: 1, min: 5 }, 5)];
+    return { lv, th, ln: { from: ln.from, to: ln.to, lanes: ln.lanes, items: ln.items.map((x) => [x.id, x.lane, x.past, x.cur]), cur: ln.cur && ln.cur.id, next: ln.next && ln.next.id }, late: [late.from, late.to], s: s.map((x) => [x.k, Math.round(x.pc * 100)]) };
