+  ok(JSON.stringify(pure.th.slice(3)) === '[{},{},{}]', 'theme map: a bare name, nothing or a non-colour = no change (default look)');
+  ok(pure.ln.from === 420 && pure.ln.to === 1320 && pure.ln.lanes === 2, 'timeline: 7am-10pm, two lanes for the overlaps: ' + JSON.stringify(pure.ln));
