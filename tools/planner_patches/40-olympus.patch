+// ===== OLYMPUS: the futuristic layer, Day timeline, Focus mode (ext-olympus.js; docs/features-olympus.md; tests/olympus.test.js) =====
+// (2026-11-03, owner: "way higher quality, 3D UI effects", "organized like a maid swept", "futuristic")
+//  - Look: glass cards (translucent in dark mode; light mode keeps its exact colours and gains depth), an aurora behind the
+//    page that glides on a view change, cards that rise in then and tilt a little under the mouse, press feedback, a tick pop.
+//  - Day timeline (Today, joined to the status line): today's events on one track with a glowing NOW beam, what is on now,
+//    and a calm empty state on a clear day.
+//  - Focus mode (#focus-mode, palette, All tools, the Timeline's Focus button, a tap on the running timer): a full-screen
+//    Pomodoro with a glowing ring. It drives the app's own focus timer (S.focus, the Focus timer sheet, the timer bar), so
+//    minutes are logged exactly as before; only the 5-minute break is this add-on's own (memory, never saved).
+//  - Olympus themes: the shared 'olympus.theme' key (a theme id; tokens from Olympus's themes.js) recolours the layer's accents
+//    through a small CSS variable map. No key or the default 'olympus' theme = the Planner's own look. The 'jfx' key (Olympus 3D quality) is followed:
+//    off = no effects, low = no motion. prefers-reduced-motion = no motion. Device key planner.olympus.fx = 'off' turns it off.
+// Loaded in <head>; waits for 'planner:ready' (window.PlannerAPI). Writes no synced data of its own.
+(function () {
+  'use strict';
+  const FX_KEY = 'planner.olympus.fx', THEME_KEY = 'olympus.theme', JFX_KEY = 'jfx';
+  const LENS = [15, 25, 45, 60], BREAK_MIN = 5, DAY_FROM = 7 * 60, DAY_TO = 22 * 60, MAX_LANES = 3;
+  const root = document.documentElement;
+  let A = null, wanted = '', lastView = '';
+
+  const get = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
+  const set = (k, v) => { try { if (v == null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { /* this visit only */ } };
+  const mq = (q) => { try { return matchMedia(q).matches; } catch (e) { return false; } };
+  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  const p2 = (n) => String(n).padStart(2, '0');
+  const dur = (m) => { m = Math.max(0, Math.round(m)); return m >= 60 ? `${Math.floor(m / 60)}h${m % 60 ? ' ' + (m % 60) + 'm' : ''}` : `${m}m`; };
+  const clock = (ms) => { const s = Math.max(0, Math.ceil(ms / 1000)); return `${p2(Math.floor(s / 60))}:${p2(s % 60)}`; };
+  const nowMin = () => { const n = new Date(); return n.getHours() * 60 + n.getMinutes(); };
+  const toMin = (hm) => { const m = /^(\d{1,2}):(\d{2})/.exec(hm || ''); return m ? +m[1] * 60 + +m[2] : null; };
+  const t12 = (m) => { let h = Math.floor(m / 60) % 24; const mm = m % 60, ap = h < 12 ? 'am' : 'pm'; h = h % 12 || 12; return (mm ? `${h}:${p2(mm)}` : `${h}`) + ap; };
+  const buzz = (ms) => { try { if (navigator.vibrate && (!navigator.userActivation || navigator.userActivation.isActive)) navigator.vibrate(ms); } catch (e) { /* optional */ } };
+
+  // =====================================================================================================================
+  // Look: effects level and the Olympus theme map (pure helpers on window.__ox)
+  // =====================================================================================================================
+  // level(planner key, jfx, reduced motion) -> 'off' | 'still' | 'move'
+  function level(own, jfx, reduced) {
+    if (own === 'off' || jfx === 'off') return 'off';
+    return reduced || jfx === 'low' ? 'still' : 'move';
+  }
+  // themeVars(theme) -> { '--ox-a', '--ox-b', '--ox-glow' } from an Olympus theme: an object (or its JSON), its tokens at the top or
+  // under .tokens / .vars, named accent / accent2 / glow (aliases below). Anything else, or a colour that is not a colour: {}.
+  const COLOR = /^(#[0-9a-f]{3,8}|(rgb|hsl)a?\([\d\s.,%/deg]+\))$/i;
+  const MAP = { '--ox-a': ['accent', 'primary', '--oly-accent'], '--ox-b': ['accent2', 'secondary', '--oly-accent2'], '--ox-glow': ['glow', '--oly-glow'] };
+  function themeVars(theme) {
+    let o = theme;
+    if (typeof o === 'string') { try { o = JSON.parse(o); } catch (e) { return {}; } }
+    if (!o || typeof o !== 'object') return {};
+    const t = [o.tokens, o.vars].find((x) => x && typeof x === 'object') || o, out = {};
+    Object.entries(MAP).forEach(([v, names]) => { const c = names.map((n) => t[n]).find((x) => typeof x === 'string' && COLOR.test(x.trim())); if (c) out[v] = c.trim(); });
+    if (out['--ox-a']) { out['--ox-b'] = out['--ox-b'] || out['--ox-a']; out['--ox-glow'] = out['--ox-glow'] || out['--ox-a']; }
+    return out;
+  }
+  // 'olympus.theme' holds a theme id (Jarvis's Look sheet); its tokens are in Olympus's themes.js (window.OLYMPUS_THEMES), from
+  // the Jarvis frame around the Planner (same origin) or loaded once from ../olympus/. No key or the default 'olympus' = nothing
+  // to do (today's look); a theme page that is not there (an old site) also leaves the default.
+  let loading = false;
+  function olympusTheme() {
+    const id = (get(THEME_KEY) || '').trim();
+    if (!id || id === 'olympus') return null;
+    if (id[0] === '{') return id; // tokens written as JSON
+    for (const w of [window, window.parent]) {
+      try { const T = w && w.OLYMPUS_THEMES; if (T && typeof T.tokens === 'function') return T.get(id) && T.get(id).id === id ? T.tokens(id, 'page') : null; } catch (e) { /* another origin */ }
+    }
+    if (!loading) {
+      loading = true;
+      const s = document.createElement('script');
+      s.src = '../olympus/themes.js'; s.onload = () => applyLook(); s.onerror = () => {};
+      document.head.appendChild(s);
+    }
+    return null;
+  }
+  let themed = [];
+  function applyLook() {
+    const lv = level(get(FX_KEY), get(JFX_KEY), mq('(prefers-reduced-motion: reduce)'));
+    root.classList.toggle('ox', lv !== 'off');
+    root.classList.toggle('ox-move', lv === 'move');
+    const vars = lv === 'off' ? {} : themeVars(olympusTheme());
+    themed.forEach((k) => { if (!(k in vars)) root.style.removeProperty(k); });
+    Object.entries(vars).forEach(([k, v]) => root.style.setProperty(k, v));
+    themed = Object.keys(vars);
+    root.toggleAttribute('data-ox-theme', themed.length > 0);
+    return lv;
+  }
+  applyLook(); // before the first paint: the page never flashes the plain look first
+
+  // =====================================================================================================================
+  // Day timeline (pure model on window.__ox)
+  // =====================================================================================================================
+  // line(items, now) with items [{ id, occ, title, s, e, c }] (minutes) -> { from, to, now, items (+lane, past, cur), lanes, cur, next }
+  function line(items, now) {
+    const list = items.filter((x) => x.s != null && x.e > x.s).sort((a, b) => a.s - b.s || b.e - a.e);
+    const from = Math.min(DAY_FROM, ...list.map((x) => Math.floor(x.s / 60) * 60));
+    const to = Math.min(1440, Math.max(DAY_TO, ...list.map((x) => Math.ceil(x.e / 60) * 60)));
+    const ends = [];
+    const out = list.map((x) => {
+      let lane = ends.findIndex((e) => e <= x.s);
+      if (lane < 0) lane = ends.length < MAX_LANES ? ends.length : ends.indexOf(Math.min(...ends));
+      ends[lane] = Math.max(ends[lane] || 0, x.e);
+      return { ...x, lane, past: x.e <= now, cur: x.s <= now && now < x.e };
+    });
+    return { from, to, now, items: out, lanes: Math.max(1, ends.length), cur: out.find((x) => x.cur) || null, next: out.find((x) => x.s > now) || null };
+  }
+  function todayItems() {
+    const k = A.todayKey();
+    return A.eventsOn(k).filter((o) => o && o.ev && !o.ev.bot && !o.ev.allDay && o.ev.start).map((o) => {
+      const s = toMin(o.ev.start), e = toMin(o.ev.end);
+      return { id: o.ev.id, occ: o.occ, title: o.ev.title || 'Event', s, e: e != null && e > s ? e : Math.min(s + 60, 1440), c: A.colorOf(o.ev) };
+    });
+  }
+  const openTasks = () => { const k = A.todayKey(); return A.S.tasks.filter((t) => t && !t.done && t.date && t.date <= k && t.tag !== 'idea'); };
+  // what is on now or next, in words (the timeline's label for screen readers and its tooltip)
+  function said(M) {
+    if (M.cur) return `Now: ${M.cur.title} until ${t12(M.cur.e)}`;
+    if (M.next) return `Next: ${M.next.title} at ${t12(M.next.s)}, in ${dur(M.next.s - M.now)}`;
+    return 'Nothing else on the calendar today';
+  }
+  function lineHtml() {
+    const items = todayItems(), tasks = openTasks(), n = nowMin();
+    if (!items.length && !tasks.length) {
+      return `<section class="ox-line ox-empty" aria-label="Day timeline"><div class="ox-orbit" aria-hidden="true"><i></i><i></i><b></b></div>
+        <div class="ox-et"><h3>Your day is wide open</h3><p>Nothing scheduled and nothing to do yet. Add a task, plan the day or start a focus round.</p>
+        <div class="ox-acts"><button type="button" class="btn sm primary" data-oxadd>Add a task</button><button type="button" class="btn sm" data-oxfocus>Focus</button></div></div></section>`;
+    }
+    const M = line(items, n), span = M.to - M.from, x = (m) => (((Math.min(Math.max(m, M.from), M.to) - M.from) / span) * 100).toFixed(2);
+    let ticks = '';
+    for (let h = Math.ceil(M.from / 60); h * 60 <= M.to; h++) ticks += `<i class="ox-tk" style="left:${x(h * 60)}%">${h % 3 === 0 && Math.abs(h * 60 - n) > span * 0.06 ? `<em>${t12(h * 60).replace(/(am|pm)$/, (s) => s[0])}</em>` : ''}</i>`;
+    const blocks = M.items.map((b, i) => `<button type="button" class="ox-blk${b.past ? ' past' : ''}${b.cur ? ' cur' : ''}" style="left:${x(b.s)}%;width:max(26px,calc(${x(b.e)}% - ${x(b.s)}%));top:calc(${b.lane} * var(--ox-lh));--c:${esc(b.c)};--i:${i}" data-ev="${esc(b.id)}" data-occ="${esc(b.occ)}" title="${esc(`${t12(b.s)}-${t12(b.e)} ${b.title}`)}"><span>${esc(b.title)}</span></button>`).join('');
+    const inDay = n >= M.from && n <= M.to;
+    const beam = inDay ? `<div class="ox-past" style="width:${x(n)}%"></div><div class="ox-now" style="left:${x(n)}%" aria-hidden="true"><b>${esc(t12(n))}</b></div>` : '';
+    // fused under the status line (one unit, no header of its own): the busy phone Today stays inside todayorg's height budget
+    return `<section class="ox-line ox-fused" aria-label="${esc('Day timeline. ' + said(M))}" title="${esc(said(M))}"><div class="ox-track" style="--lanes:${M.lanes}">${ticks}${beam}${blocks}</div></section>`;
+  }
+  // Today is drawn by the app (#main.innerHTML); the timeline goes under the status line each time, before the browser paints.
+  function onMain() {
+    const tdy = document.querySelector('#main > .tdy');
+    const view = A.S.view, entered = !!lastView && view !== lastView; lastView = view;
+    const main = document.getElementById('main');
+    // cards rise in (and the aurora glides) when you switch views; never at start (the page is there at once) and never on the
+    // redraws that follow every tick of a task
+    main.classList.toggle('ox-enter', entered && root.classList.contains('ox-move'));
+    if (entered) root.style.setProperty('--ox-d', [...view].reduce((a, c) => a + c.charCodeAt(0), 0) % 5 - 2);
+    if (!tdy || tdy.querySelector(':scope > .ox-line')) return;
+    const at = tdy.querySelector(':scope > #toStrip') || tdy.querySelector(':scope > .td-h');
+    const strip = tdy.querySelector(':scope > #toStrip'), bar = tdy.querySelector(':scope > .td-h > div:last-child');
+    if (strip) strip.classList.toggle('ox-calm', /^Nothing urgent/.test(strip.textContent));
+    // Focus joins the header's even button row (the plain look keeps its own header; Focus mode stays in the palette and tools)
+    if (bar && root.classList.contains('ox') && !bar.querySelector('[data-oxfocus]')) bar.insertAdjacentHTML('afterbegin', '<button type="button" class="btn sm" data-oxfocus title="Full-screen focus timer">Focus</button>');
+    try { if (at) at.insertAdjacentHTML('afterend', lineHtml()); } catch (e) { console.error('Planner timeline:', e); }
+    if (strip) strip.classList.toggle('ox-top', !!tdy.querySelector(':scope > .ox-fused'));
+    [...tdy.children].slice(0, 14).forEach((el, i) => el.style.setProperty('--ox-i', i));
+  }
+  function beamTick() {
+    const old = document.querySelector('#main > .tdy > .ox-line');
+    if (!old || !A) return;
+    try { const fresh = document.createElement('div'); fresh.innerHTML = lineHtml(); fresh.firstElementChild.classList.add('ox-tick'); old.replaceWith(fresh.firstElementChild); } catch (e) { /* next tick */ }
+  }
+
+  // =====================================================================================================================
+  // Focus mode: a full-screen face for the app's own focus timer
+  // =====================================================================================================================
+  let fx = null, fxTimer = 0, fxPick = '', brk = null, painted = '';
+  const R = 108, C = 2 * Math.PI * R;
+  // state(focus, brk, now) -> { k: 'idle' | 'run' | 'done' | 'break', left, total, pc }
+  function state(f, b, now) {
+    if (f && f.status === 'run') { const total = f.min * 60000, left = Math.max(0, f.start + total - now); return { k: 'run', left, total, pc: 1 - left / total }; }
+    if (b && b.end > now) { const total = b.min * 60000, left = b.end - now; return { k: 'break', left, total, pc: 1 - left / total }; }
+    if (f && f.status === 'done') return { k: 'done', left: 0, total: f.min * 60000, pc: 1 };
+    return { k: 'idle', left: 0, total: 0, pc: 0 };
+  }
+  const titleOf = (f) => { const t = A.S.tasks.find((x) => x && x.id === f.tid); return t ? t.title : f.title || 'Task'; };
+  const minsToday = () => { const k = A.todayKey(); return A.S.tasks.reduce((a, t) => a + ((t && t.fl && +t.fl[k]) || 0), 0); };
+  function fxBody(st) {
+    const f = A.S.focus;
+    if (st.k === 'run') return `<div class="ox-fx-acts"><button type="button" class="ox-b go" data-oxf="finish">Finish and log</button><button type="button" class="ox-b" data-oxf="cancel">Cancel</button><button type="button" class="ox-b" data-oxf="close">Minimise</button></div>`;
+    if (st.k === 'break') return `<p class="ox-fx-msg">Stand up, breathe, look far away.</p><div class="ox-fx-acts"><button type="button" class="ox-b" data-oxf="skip">Skip the break</button></div>`;
+    if (st.k === 'done') return `<p class="ox-fx-msg"><b>${f.logged || 0} min logged</b> on ${esc(titleOf(f))}.</p><div class="ox-fx-acts"><button type="button" class="ox-b go" data-oxf="break">${BREAK_MIN} min break</button><button type="button" class="ox-b" data-oxf="again">Another round</button><button type="button" class="ox-b" data-oxf="close">Close</button></div>`;
+    const list = openTasks().sort((a, b) => (+b.p || 0) - (+a.p || 0)).slice(0, 6);
+    if (!list.length) return `<p class="ox-fx-msg">No tasks for today. Add one on Today, then come back for a focus round.</p><div class="ox-fx-acts"><button type="button" class="ox-b" data-oxf="close">Close</button></div>`;
+    if (!list.some((t) => t.id === fxPick)) fxPick = list[0].id;
+    return `<div class="ox-fx-lbl">${brk && brk.over ? 'Break over. ' : ''}Pick a task</div><div class="ox-chips" role="group" aria-label="Task">${list.map((t) => `<button type="button" class="ox-chip" data-oxtask="${esc(t.id)}" aria-pressed="${t.id === fxPick}">${esc(t.title)}</button>`).join('')}</div>
+      <div class="ox-fx-lbl">Length</div><div class="ox-chips" role="group" aria-label="Length">${LENS.map((n) => `<button type="button" class="ox-chip" data-oxlen="${n}" aria-pressed="${n === A.S.focusLen}">${n} min</button>`).join('')}</div>
+      <div class="ox-fx-acts"><button type="button" class="ox-b go" data-oxf="start">Start focus</button></div>`;
+  }
+  function fxPaint() {
+    if (!fx || !fx.open) return;
+    const st = state(A.S.focus, brk, Date.now()), f = A.S.focus;
+    if (brk && st.k !== 'break' && brk.end <= Date.now() && !brk.over) { brk.over = true; buzz([120, 80, 120]); }
+    const key = st.k + '|' + (f ? f.tid + f.start + f.status : '') + '|' + fxPick + '|' + A.S.focusLen + '|' + (brk && brk.over ? 1 : 0);
+    fx.dataset.st = st.k;
+    const shown = st.k === 'idle' ? A.S.focusLen * 60000 : st.left;
+    fx.querySelector('.arc').style.strokeDashoffset = (C * (1 - (st.k === 'idle' ? 1 : st.pc))).toFixed(1);
+    fx.querySelector('#oxFxTime').textContent = clock(shown);
+    fx.querySelector('#oxFxMode').textContent = { run: 'Focus', break: 'Break', done: 'Done', idle: 'Ready' }[st.k];
+    if (key === painted) return;
+    painted = key;
+    fx.querySelector('#oxFxTask').textContent = st.k === 'run' || st.k === 'done' ? titleOf(f) : st.k === 'break' ? 'Break' : 'Focus mode';
+    fx.querySelector('#oxFxBody').innerHTML = fxBody(st);
+    const m = minsToday();
+    fx.querySelector('#oxFxStat').textContent = m ? `${dur(m)} focused today` : 'No focus logged today yet';
+  }
+  function fxStart(tid, min) {
+    const form = document.getElementById('focForm'), dlg = document.getElementById('focDlg');
+    if (!form || !A.S.tasks.some((t) => t && t.id === tid)) return;
+    brk = null;
+    A.S.focusLen = LENS.includes(min) ? min : 25;
+    A.openFocus(tid); // the app's own sheet sets the task; submitting it starts the timer exactly as a tap on Start focus would
+    if (dlg && dlg.open) dlg.close();
+    form.requestSubmit();
+    buzz(14);
+  }
+  const barBtn = (sel) => { const b = document.querySelector('#focusBar ' + sel); if (b) b.click(); };
+  function fxAct(a) {
+    const f = A.S.focus;
+    if (a === 'start') fxStart(fxPick, A.S.focusLen);
