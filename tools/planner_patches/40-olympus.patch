+  ok(JSON.stringify(pure.late) === '[360,1440]', 'timeline: widens to the earliest start and latest end, never past midnight');
+  ok(JSON.stringify(pure.s) === '[["run",20],["break",50],["done",100],["idle",0]]', 'focus state: run, break, done, idle (a break that ended)');
