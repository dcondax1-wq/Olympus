+
+  // ---------- 2. the look on: classes, light colours unchanged, the background layer ----------
+  const look = await p.evaluate(() => { const h = document.documentElement, cs = (s) => getComputedStyle(document.querySelector(s)); return { ox: h.classList.contains('ox'), mv: h.classList.contains('ox-move'), card: cs('.td-card').backgroundColor, tdy: cs('.tdy').backgroundColor, body: cs('body').backgroundColor, bg: !!document.querySelector('body > .ox-bg') }; });
+  ok(look.ox && look.mv && look.bg, 'the layer is on with motion and its background: ' + JSON.stringify(look));
+  ok(look.card === 'rgb(255, 255, 255)' && look.tdy === 'rgba(0, 0, 0, 0)' && look.body === 'rgb(255, 255, 255)', 'light mode keeps its exact colours: ' + JSON.stringify(look));
+
+  // ---------- 3. the Day timeline ----------
+  const tl = await p.evaluate(() => { const l = document.querySelector('.tdy > .ox-line'); return l && { after: l.previousElementSibling && l.previousElementSibling.id, n: l.querySelectorAll('.ox-blk').length, cur: [...l.querySelectorAll('.ox-blk.cur')].map((x) => x.textContent), past: l.querySelectorAll('.ox-blk.past').length, now: (l.querySelector('.ox-now') || {}).style.left, lanes: l.querySelector('.ox-track').style.getPropertyValue('--lanes') }; });
+  // fullState today: Electric 7am-3:30pm (repeats weekdays), Dentist 2-3pm, Outback 4-10pm, Podcast 4:30-5:30pm, Gym 6-7pm
+  ok(tl && tl.after === 'toStrip' && tl.n === 5, 'the timeline sits under the status line with today\'s 5 events: ' + JSON.stringify(tl));
+  ok(tl && JSON.stringify(tl.cur) === '["Electric"]' && tl.past === 0 && tl.lanes === '2', 'Electric is on now, nothing past, overlaps in a second lane: ' + JSON.stringify(tl));
+  ok(tl && tl.now === `${((750 - 420) / 900 * 100).toFixed(2)}%`, 'the NOW beam sits at 12:30pm: ' + (tl && tl.now));
+  const said = () => p.getAttribute('.ox-line', 'aria-label');
+  ok(await said() === 'Day timeline. Now: Electric until 3:30pm', 'it says what is on now: ' + await said());
+  ok(await p.evaluate(() => document.querySelector('#toStrip').classList.contains('ox-top') && !!document.querySelector('.tdy > .td-h [data-oxfocus]')), 'one unit with the status line; Focus joins the header buttons');
+  ok(await p.locator('.tdy > .ox-line').count() === 1, 'one timeline only');
+  await p.clock.fastForward(3 * 3600e3); await wait(300);
+  ok(await said() === 'Day timeline. Next: Outback Steakhouse at 4pm, in 30m' && await p.locator('.ox-blk.past').count() === 2, 'the beam moves on by itself: ' + await said());
+  await p.click('.ox-blk:has-text("Gym")'); await wait(300);
+  ok(await p.evaluate(() => { const d = document.querySelector('#fTitle').closest('dialog'); return d.open && document.querySelector('#fTitle').value === 'Gym'; }), 'a tap on a block opens that event');
+  await p.keyboard.press('Escape'); await wait(200);
+  ok(await p.evaluate(() => document.documentElement.scrollWidth) <= 390, 'no sideways scroll at 390px');
+  errs.push(...pe); await ctx.close();
+
+  // ---------- 4. a clear day: the empty state ----------
+  ({ ctx, p, errs: pe } = await open(b, { state: empty() }));
+  ok(await p.locator('.ox-line.ox-empty').count() === 1 && /Your day is wide open/.test(await txt(p, '.ox-empty')), 'a clear day shows the empty state');
+  ok(await p.evaluate(() => document.querySelector('#toStrip').classList.contains('ox-calm')), 'nothing urgent: the status dot is green');
+  await p.click('[data-oxadd]'); await wait(200);
+  ok(await p.evaluate(() => !!document.activeElement && !!document.activeElement.closest('[data-tadd]')), 'Add a task puts the cursor in the task box');
+  errs.push(...pe); await ctx.close();
+
+  // ---------- 5. Focus mode drives the app's own timer ----------
+  ({ ctx, p, errs: pe } = await open(b, { state: fullState(), seed: seedNq(), hash: '#focus-mode' }));
+  ok(await p.evaluate(() => document.querySelector('#oxFocus').open), '#focus-mode opens Focus mode');
+  ok(await p.locator('#oxFocus [data-oxtask]').count() >= 3 && /^25:00$/.test(await txt(p, '#oxFxTime')), 'idle: today\'s tasks to pick, the ring shows the length');
+  await p.click('#oxFocus [data-oxtask="t1"]'); await p.click('#oxFocus [data-oxlen="15"]'); await p.click('#oxFocus [data-oxf="start"]'); await wait(300);
+  let s = await st(p);
+  ok(s.focus && s.focus.tid === 't1' && s.focus.min === 15 && s.focus.status === 'run' && s.focusLen === 15, 'Start runs the app\'s focus timer on the task: ' + JSON.stringify(s.focus));
+  ok(await p.evaluate(() => !document.querySelector('#focDlg').open && !document.querySelector('#focusBar').hidden), 'the app\'s sheet never shows; its timer bar runs behind');
+  await p.clock.fastForward(5 * 60e3); await wait(1200);
+  ok(/^(10:00|09:5\d)$/.test(await txt(p, '#oxFxTime')) && (await p.getAttribute('#oxFocus', 'data-st')) === 'run', 'the ring counts down: ' + await txt(p, '#oxFxTime'));
+  await p.clock.fastForward(10 * 60e3 + 2000); await wait(1200);
+  s = await st(p);
+  ok(s.focus && s.focus.status === 'done' && s.tasks.find((t) => t.id === 't1').fl[TODAY] === 15, 'at the end the app logs the 15 minutes on the task');
+  ok((await p.getAttribute('#oxFocus', 'data-st')) === 'done' && /15 min logged/.test(await txt(p, '#oxFxBody')) && /15m focused today/.test(await txt(p, '#oxFxStat')), 'done: minutes logged and today\'s total');
+  await p.click('#oxFocus [data-oxf="break"]'); await wait(300);
+  ok((await p.getAttribute('#oxFocus', 'data-st')) === 'break' && /^0(5:00|4:5\d)$/.test(await txt(p, '#oxFxTime')) && !(await st(p)).focus, 'a 5 minute break; the done bar is dismissed');
+  await p.clock.fastForward(5 * 60e3 + 1000); await wait(1200);
+  ok((await p.getAttribute('#oxFocus', 'data-st')) === 'idle' && /Break over/.test(await txt(p, '#oxFxBody')), 'the break ends by itself, ready for the next round');
+  await p.click('#oxFocus [data-oxf="start"]'); await wait(300);
+  await p.clock.fastForward(3 * 60e3 + 500); await wait(1200);
+  await p.click('#oxFocus [data-oxf="finish"]'); await wait(300);
+  s = await st(p);
+  ok(!s.focus && s.tasks.find((t) => t.id === 't1').fl[TODAY] === 18, 'Finish and log stops early and logs the 3 minutes: ' + JSON.stringify(s.tasks.find((t) => t.id === 't1').fl));
+  await p.click('#oxFocus [data-oxf="start"]'); await wait(200); await p.click('#oxFocus [data-oxf="cancel"]'); await wait(300);
+  ok(!(await st(p)).focus && (await st(p)).tasks.find((t) => t.id === 't1').fl[TODAY] === 18, 'Cancel stops without logging');
+  await p.click('#oxFocus [data-oxf="start"]'); await wait(200); await p.keyboard.press('Escape'); await wait(300);
+  ok(await p.evaluate(() => !document.querySelector('#oxFocus').open) && (await st(p)).focus.status === 'run', 'Escape minimises; the timer keeps running in the bar');
+  await p.click('#fbTime'); await wait(300);
+  ok(await p.evaluate(() => document.querySelector('#oxFocus').open) && (await p.getAttribute('#oxFocus', 'data-st')) === 'run', 'a tap on the bar\'s time brings Focus mode back');
+  ok(await p.evaluate(() => document.documentElement.scrollWidth) <= 390, 'Focus mode: no sideways scroll at 390px');
+  errs.push(...pe); await ctx.close();
+
+  // ---------- 6. Olympus themes, switches and reduced motion ----------
+  ({ ctx, p, errs: pe } = await open(b, { state: fullState(), local: { 'olympus.theme': JSON.stringify({ name: 'gold', accent: '#f7c948', accent2: '#ff7a1a' }) } }));
+  const v = () => p.evaluate(() => [getComputedStyle(document.documentElement).getPropertyValue('--ox-a').trim(), getComputedStyle(document.documentElement).getPropertyValue('--ox-b').trim(), document.documentElement.hasAttribute('data-ox-theme')]);
+  ok(JSON.stringify(await v()) === '["#f7c948","#ff7a1a",true]', 'olympus.theme recolours the layer: ' + JSON.stringify(await v()));
+  const p2 = await ctx.newPage(); await p2.goto(p.url()); await p2.evaluate(() => localStorage.removeItem('olympus.theme')); await wait(300);
+  ok(JSON.stringify(await v()) === '["#6366f1","#06b6d4",false]', 'clearing the theme in another tab (Jarvis) brings the default back live: ' + JSON.stringify(await v()));
+  await p2.evaluate(() => localStorage.setItem('jfx', 'off')); await wait(300);
+  ok(await p.evaluate(() => !document.documentElement.classList.contains('ox')), 'Olympus 3D quality off (jfx) turns the layer off live');
+  await p2.close(); errs.push(...pe); await ctx.close();
+  ({ ctx, p, errs: pe } = await open(b, { state: fullState(), local: { 'planner.olympus.fx': 'off' } }));
+  ok(await p.evaluate(() => !document.documentElement.classList.contains('ox')), 'the device switch turns it off');
+  await p.evaluate(() => PlannerAPI.PK_CMDS.find((c) => c.id === 'ox-fx-on').run()); await wait(200);
+  ok(await p.evaluate(() => document.documentElement.classList.contains('ox') && localStorage.getItem('planner.olympus.fx') === null), 'the palette turns it back on');
+  errs.push(...pe); await ctx.close();
+  // a theme id (what Jarvis's Look sheet stores): the tokens come from Olympus's themes.js, loaded once from ../olympus/
+  for (const [id, want, asked] of [['zeus', '#4da3ff', 1], ['olympus', '#6366f1', 0], ['nope', '#6366f1', 1]]) {
+    const c3 = await b.newContext({ viewport: { width: 390, height: 844 } }); const q = await c3.newPage(); let hits = 0;
+    await q.route('**/olympus/themes.js', (r) => { hits++; r.fulfill({ contentType: 'text/javascript', body: "window.OLYMPUS_THEMES={get:function(i){return i==='zeus'?{id:'zeus'}:null},tokens:function(){return {accent:'#4da3ff',accent2:'#e8f4ff',glow:'#7cc4ff'}}};" }); });
+    await q.addInitScript((v) => { try { localStorage.setItem('olympus.theme', v); } catch (e) { /* none */ } }, id);
+    await q.goto(`http://127.0.0.1:${L.PORT}/nq-dashboard/planner/index.html`); await q.waitForSelector('.tdy'); await wait(500);
+    const got = await q.evaluate(() => getComputedStyle(document.documentElement).getPropertyValue('--ox-a').trim());
+    ok(got === want && hits === asked, `theme id ${id}: accent ${got} (want ${want}), themes.js asked ${hits}x`);
+    await c3.close();
+  }
+  {
+    const c2 = await b.newContext({ viewport: { width: 390, height: 844 }, reducedMotion: 'reduce' }); const q = await c2.newPage();
+    await q.goto(`http://127.0.0.1:${L.PORT}/nq-dashboard/planner/index.html`); await q.waitForSelector('.tdy'); await wait(500);
+    ok(await q.evaluate(() => document.documentElement.classList.contains('ox') && !document.documentElement.classList.contains('ox-move') && getComputedStyle(document.querySelector('#toStrip'), '::before').animationName === 'none' &&/^(none|(all )?0s)/.test(getComputedStyle(document.querySelector('.ox-bg i')).transition)), 'reduced motion: the look stays, nothing moves');
+    await c2.close();
+  }
+
+  await b.close();
+  if (errs.length) { console.log('FAIL\n' + errs.join('\n')); process.exit(1); }
+  console.log(`OLYMPUS OK (${checks} checks)`);
+})().catch((e) => { console.error(e); process.exit(1); });
