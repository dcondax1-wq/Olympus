+// ===== BOARD: the week board, plan my day, the habit heatmap, Pomodoro stats (ext-board.js; docs/features-board.md; tests/board.test.js) =====
+// (2026-11-04, owner: "more useful, more futuristic")
+//  - Plan my day: reads today's free gaps, your open tasks and the bots' trading window (entries 02:00-15:30 ET, flat 15:55 ET, the NY
+//    open 09:30 ET) and the bots' last live status (device copy planner.ext.live, READ ONLY) and proposes where each task fits, with
+//    the reason, a pre-open prep slot and a post-flat journal slot. Nothing is written: Copy puts the plan on the clipboard.
+//  - Week board: seven columns, events and tasks per day, a load bar against the free time, tick a task done or push it a day.
+//    Those two go through the Planner's own snapshot / commit, so Undo works.
+//  - Habit heatmap: the last 12 weeks of every habit as a grid, the run you are on, the best run, the 30-day rate.
+//  - Pomodoro stats: focus minutes today / this week against last week, the best day, 14 days of bars, rounds, by project.
+// Loaded in <head>; waits for 'planner:ready'. Own data: none. Device key: none. Follows the Olympus layer's variables (--ox-a, --ox-b).
+(function () {
+  'use strict';
+  const root = document.documentElement;
+  let A = null, wanted = '', dlg = null, weekOff = 0, tick = 0;
+  const get = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
+  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  const p2 = (n) => String(n).padStart(2, '0');
+  const kOf = (d) => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
+  const dOf = (k) => { const [y, m, d] = k.split('-').map(Number); return new Date(y, m - 1, d); };
+  const plus = (k, n) => { const d = dOf(k); d.setDate(d.getDate() + n); return kOf(d); };
+  const today = () => kOf(new Date());
+  const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+  const toMin = (hm) => { const m = /^(\d{1,2}):(\d{2})/.exec(hm || ''); return m ? +m[1] * 60 + +m[2] : null; };
+  const fromMin = (m) => `${p2(Math.floor(m / 60) % 24)}:${p2(m % 60)}`;
+  const t12 = (m) => { let h = Math.floor(m / 60) % 24; const mm = m % 60, ap = h < 12 ? 'am' : 'pm'; h = h % 12 || 12; return (mm ? `${h}:${p2(mm)}` : `${h}`) + ap; };
+  const dur = (m) => { m = Math.max(0, Math.round(m)); return m >= 60 ? `${Math.floor(m / 60)}h${m % 60 ? ' ' + (m % 60) + 'm' : ''}` : `${m}m`; };
+  const est = (x) => (+x.est > 0 ? +x.est : 30);
+  const isOpen = (x) => !!x && !x.done && x.tag !== 'idea' && !/^Idea:/.test(x.title || '');
+  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
+
+  // =====================================================================================================================
+  // Pure helpers (also on window.__bd for the tests)
+  // =====================================================================================================================
+  // The bots' window in New York minutes: entries 02:00-15:30, the NY open 09:30, flat 15:55 (STRATEGY.md). Weekdays only.
+  const BOT = { from: 2 * 60, to: 15 * 60 + 30, open: 9 * 60 + 30, flat: 15 * 60 + 55 };
+
+  // planDay({ gaps: [[s, e]] free gaps in local minutes, tasks, now (local minutes), win: { from, to, open, flat } in local minutes or null (no bot window today),
+  //           bots: { running, verdict, pos, roomFrac } or null }) -> { slots: [{ s, e, id, title, why }], notes: [string], deep: [s, e] | null, left: [titles that did not fit] }
+  function planDay(o) {
+    const now = Math.ceil((o.now == null ? 0 : o.now) / 5) * 5, win = o.win || null, notes = [], slots = [], BUF = 5;
+    let gaps = (o.gaps || []).map(([s, e]) => [Math.max(s, now), e]).filter(([s, e]) => e - s >= 10).sort((a, b) => a[0] - b[0]);
+    // a pre-open prep slot (15 min) in the last gap that ends before the NY open, a post-flat journal slot (20 min) in the first gap after flat
+    const take = (gi, s, len, id, title, why) => { const [gs, ge] = gaps[gi]; slots.push({ s, e: s + len, id, title, why }); const rest = []; if (s - gs >= 10) rest.push([gs, s]); if (ge - (s + len) >= 10) rest.push([s + len, ge]); gaps.splice(gi, 1, ...rest); };
+    if (win) {
+      const pre = gaps.map((g, i) => [g, i]).filter(([g]) => g[0] < win.open && Math.min(g[1], win.open) - g[0] >= 15).pop();
+      if (pre) take(pre[1], Math.max(pre[0][0], Math.min(pre[0][1], win.open) - 15), 15, 'prep', 'Pre-open prep: read the plan, check the bots', 'before the NY open');
+      const post = gaps.map((g, i) => [g, i]).filter(([g]) => g[1] > win.flat + 5 && g[1] - Math.max(g[0], win.flat + 5) >= 20)[0];
+      if (post) take(post[1], Math.max(post[0][0], win.flat + 5), 20, 'journal', 'Journal: what the bots did, what you did', 'after the bots are flat');
+    }
+    const tasks = (o.tasks || []).slice().sort((a, b) => (b.over ? 1 : 0) - (a.over ? 1 : 0) || (b.p || 0) - (a.p || 0) || est(b) - est(a));
+    const left = [];
+    for (const t of tasks) {
+      const need = est(t) + BUF, big = (t.p || 0) >= 2 || est(t) >= 45;
+      const fits = gaps.map((g, i) => [g, i]).filter(([g]) => g[1] - g[0] >= need);
+      if (!fits.length) { left.push(t.title); continue; }
+      // big tasks take the longest gap that sits outside the bots' busy hours when there is one (quiet = after flat or before the open), else the longest;
+      // small ones take the shortest gap that fits (keep the long gaps for the big ones)
+      const quiet = (g) => !win || g[0] >= win.flat || g[1] <= win.open;
+      const pick = big ? fits.slice().sort((a, b) => (quiet(b[0]) ? 1 : 0) - (quiet(a[0]) ? 1 : 0) || (b[0][1] - b[0][0]) - (a[0][1] - a[0][0]) || a[0][0] - b[0][0])[0] : fits.slice().sort((a, b) => (a[0][1] - a[0][0]) - (b[0][1] - b[0][0]) || a[0][0] - b[0][0])[0];
+      const g = pick[0];
+      take(pick[1], g[0], est(t), t.id, t.title, t.over ? 'overdue: first' : (t.p || 0) >= 2 ? (quiet(g) ? 'priority, in a quiet stretch' : 'priority') : est(t) <= 20 ? 'a short one in a short gap' : 'fits here');
+    }
+    slots.sort((a, b) => a.s - b.s);
+    const bots = o.bots || null;
+    if (!win) notes.push('The bots have no entry window today. Plan around your own day.');
+    else if (bots) {
+      if (bots.pos) notes.push('A bot is in a trade right now. Keep big decisions off the PC until it is flat.');
+      if (bots.running === false || (bots.verdict && /halt|stop|down/i.test(bots.verdict.level || '') )) notes.push('The bots look stopped or halted. Check the PC before the NY open' + (bots.verdict && bots.verdict.reason ? ': ' + bots.verdict.reason : '.'));
+      if (bots.roomFrac != null && bots.roomFrac < 0.25) notes.push('Eval room is thin. Today is a hands-off day: do not add risk.');
+    } else notes.push('No live bot status on this phone yet (open Bots and projects once). The plan uses the window only.');
+    const deep = slots.filter((s) => s.id !== 'prep' && s.id !== 'journal').sort((a, b) => (b.e - b.s) - (a.e - a.s))[0];
+    return { slots, notes, deep: deep ? [deep.s, deep.e] : null, left };
+  }
+
+  // heat(habits, endKey, weeks) -> [{ name, color, cells: [{ k, on, future }], run, best, rate30, total }] cells oldest first, week columns (Mon-Sun) x weeks
+  function heat(habits, endKey, weeks) {
+    weeks = weeks || 12;
+    const endD = dOf(endKey), dow = (endD.getDay() + 6) % 7;                    // Monday = 0
+    const startK = plus(endKey, -(dow + (weeks - 1) * 7));
+    return (habits || []).filter((h) => h && (h.name || h.title)).map((h) => {
+      const done = new Set(Array.isArray(h.done) ? h.done : []), cells = [];
+      for (let i = 0; i < weeks * 7; i++) { const k = plus(startK, i); cells.push({ k, on: done.has(k), future: k > endKey }); }
+      let run = 0, k = done.has(endKey) ? endKey : plus(endKey, -1); while (done.has(k) && run < 3660) { run++; k = plus(k, -1); }
+      const all = [...done].filter((x) => /^\d{4}-\d{2}-\d{2}$/.test(x)).sort();
+      let best = 0, cur = 0, prev = '';
+      all.forEach((x) => { cur = prev && plus(prev, 1) === x ? cur + 1 : 1; best = Math.max(best, cur); prev = x; });
+      let n30 = 0; for (let i = 0; i < 30; i++) if (done.has(plus(endKey, -i))) n30++;
+      return { name: h.name || h.title, color: h.color || '#6366f1', cells, run, best, rate30: Math.round(n30 / 30 * 100), total: all.length };
+    });
+  }
+
+  // pomo(tasks, today) -> focus minutes (task.fl = { day: minutes }): today, this week (Mon-today) and the 7 days before, the best day, 14 bars, rounds today, by project
+  function pomo(tasks, t) {
+    const fl = (k) => (tasks || []).reduce((a, x) => a + ((x && x.fl && +x.fl[k]) || 0), 0);
+    const dow = (dOf(t).getDay() + 6) % 7, wk0 = plus(t, -dow);
+    const days = []; for (let i = 13; i >= 0; i--) { const k = plus(t, -i); days.push({ k, m: fl(k) }); }
+    const week = []; for (let i = 0; i <= dow; i++) week.push(fl(plus(wk0, i)));
+    const prev = []; for (let i = 1; i <= 7; i++) prev.push(fl(plus(wk0, -i)));
+    const sum = (a) => a.reduce((x, y) => x + y, 0), best = days.reduce((a, d) => (d.m > a.m ? d : a), { k: '', m: 0 });
+    const proj = new Map(); (tasks || []).forEach((x) => { if (x && x.fl) { const m = days.reduce((a, d) => a + (+x.fl[d.k] || 0), 0); if (m > 0) proj.set(x.proj || 'No project', (proj.get(x.proj || 'No project') || 0) + m); } });
+    return { today: fl(t), week: sum(week), prev: sum(prev), best, days, avg14: Math.round(sum(days.map((d) => d.m)) / 14), rounds: (tasks || []).filter((x) => x && x.fl && +x.fl[t] > 0).length,
+      byProj: [...proj.entries()].map(([name, m]) => ({ name, m })).sort((a, b) => b.m - a.m).slice(0, 4) };
+  }
+
+  // =====================================================================================================================
+  // The app's numbers -> the helpers
+  // =====================================================================================================================
+  function localWin(day) {
+    const dow = dOf(day).getDay(); if (dow === 0 || dow === 6) return null;
+    const conv = (m) => { try { const r = A.etToLocal(day, fromMin(m)); const x = toMin(r.hm); return r.date === day && x != null ? x : (r.date > day ? 1440 : 0); } catch (e) { return m; } };
+    return { from: conv(BOT.from), to: conv(BOT.to), open: conv(BOT.open), flat: conv(BOT.flat) };
+  }
+  function gapsOf(k) { try { const trv = (A.bfSpans(k) || []).map((x) => [x.s, x.e]); return A.freeGaps(k, 6 * 60, 22 * 60, 15, trv); } catch (e) { return []; } }
+  function liveBots() {
+    try {
+      const c = JSON.parse(get('planner.ext.live') || 'null'), v = c && c.v;
+      if (!v) return null;
+      const accts = [v.lit, v.atlas, v.blitz].filter(Boolean);
+      return { running: v.running === true ? true : v.running === false ? false : null, verdict: v.verdict || null, pos: accts.some((a) => a && a.pos && a.pos.qty), roomFrac: accts.reduce((m, a) => (a && a.roomFrac != null ? Math.min(m, a.roomFrac) : m), 1), at: c.at || 0 };
+    } catch (e) { return null; }
+  }
+  function openTasksToday() {
+    const t = today();
+    return A.S.tasks.filter((x) => isOpen(x) && x.date && x.date <= t).map((x) => ({ id: x.id, title: x.title || 'Task', est: est(x), p: x.p || 0, over: x.date < t }));
+  }
+  function dayPlan() {
+    const t = today(), n = new Date();
+    return planDay({ gaps: gapsOf(t), tasks: openTasksToday(), now: n.getHours() * 60 + n.getMinutes(), win: localWin(t), bots: liveBots() });
+  }
+  function planText(P) {
+    return ['Plan for ' + new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })]
+      .concat(P.slots.map((s) => `${t12(s.s)}-${t12(s.e)}  ${s.title} (${s.why})`), P.left.length ? ['Did not fit: ' + P.left.join(', ')] : [], P.notes).join('\n');
+  }
+
+  // =====================================================================================================================
+  // Drawing
+  // =====================================================================================================================
+  function planHtml() {
+    const P = dayPlan(), n = new Date().getHours() * 60 + new Date().getMinutes();
+    const rows = P.slots.length ? P.slots.map((s) => `<li class="bd-slot${P.deep && P.deep[0] === s.s ? ' deep' : ''}"><b>${esc(t12(s.s))}</b><span>${esc(s.title)}<small>${esc(s.why)} · ${dur(s.e - s.s)}</small></span></li>`).join('')
+      : `<li class="bd-none">${n >= 22 * 60 ? 'The day is done. Rest.' : 'Nothing to place: no open task fits a free gap, or you are clear.'}</li>`;
+    return `<ol class="bd-plan">${rows}</ol>${P.left.length ? `<p class="bd-note">Did not fit today: ${P.left.map(esc).join(', ')}. Move one or free some time.</p>` : ''}${P.notes.map((t) => `<p class="bd-note bot">${esc(t)}</p>`).join('')}<div class="bd-acts"><button type="button" class="bd-b" data-bd="copy">Copy the plan</button></div>`;
+  }
+  function weekDays() { const t = today(), dow = (dOf(t).getDay() + 6) % 7, m0 = plus(t, -dow + weekOff * 7); return Array.from({ length: 7 }, (_, i) => plus(m0, i)); }
+  function weekHtml() {
+    const t = today(), days = weekDays(), S = A.S;
+    const cols = days.map((k) => {
+      const evs = (A.eventsOn(k) || []).filter((o) => o && o.ev && !o.ev.bot).sort((a, b) => (toMin(a.ev.start) ?? -1) - (toMin(b.ev.start) ?? -1));
+      const tasks = S.tasks.filter((x) => x && x.date && (x.date === k || (k === t && x.date < t && isOpen(x))) && x.tag !== 'idea');
+      const need = tasks.filter(isOpen).reduce((a, x) => a + est(x), 0), cap = Math.max(60, gapsOf(k).reduce((a, [s, e]) => a + (e - s), 0) * 0.6), load = clamp(need / cap, 0, 1.6);
+      return `<section class="bd-col${k === t ? ' today' : ''}" data-day="${k}"><h4>${WD[dOf(k).getDay()]} <small>${dOf(k).getDate()}</small></h4><i class="bd-load${load > 1 ? ' over' : ''}" style="--w:${Math.round(Math.min(1, load) * 100)}%" title="${dur(need)} of ${dur(cap)}"></i>`
+        + evs.map((o) => `<div class="bd-ev">${o.ev.allDay || !o.ev.start ? '' : `<b>${esc(t12(toMin(o.ev.start)))}</b> `}${esc(o.ev.title || 'Event')}</div>`).join('')
+        + tasks.map((x) => `<div class="bd-t${x.done ? ' done' : ''}${x.date < k ? ' old' : ''}"><button type="button" class="bd-tick" data-bdtask="${esc(x.id)}" aria-label="${x.done ? 'Mark not done' : 'Mark done'}: ${esc(x.title)}" aria-pressed="${!!x.done}"></button><span>${esc(x.title)}</span>${x.done ? '' : `<button type="button" class="bd-push" data-bdpush="${esc(x.id)}" aria-label="Move to the next day: ${esc(x.title)}">›</button>`}</div>`).join('')
+        + (evs.length || tasks.length ? '' : '<p class="bd-empty">Clear</p>') + '</section>';
+    }).join('');
+    const label = `${dOf(days[0]).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })} - ${dOf(days[6]).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`;
+    return `<div class="bd-nav"><button type="button" class="bd-b" data-bd="prev" aria-label="Previous week">‹</button><b>${esc(label)}${weekOff === 0 ? ' · this week' : ''}</b><button type="button" class="bd-b" data-bd="next" aria-label="Next week">›</button></div><div class="bd-week">${cols}</div>`;
+  }
+  function heatHtml() {
+    const H = heat(A.S.habits, today(), 12);
+    if (!H.length) return '<p class="bd-note">No habits yet. Add one in Habits and its heatmap shows here.</p>';
+    return H.map((h) => `<div class="bd-h"><div class="bd-hh"><b style="color:${esc(h.color)}">${esc(h.name)}</b><small>${h.run} day${h.run === 1 ? '' : 's'} in a row · best ${h.best} · ${h.rate30}% of 30 days</small></div>`
+      + `<div class="bd-grid" role="img" aria-label="${esc(h.name)}: ${h.total} days done, 12 weeks">${h.cells.map((c) => `<i class="${c.on ? 'on' : ''}${c.future ? ' fut' : ''}" style="--c:${esc(h.color)}" title="${esc(c.k)}"></i>`).join('')}</div></div>`).join('');
+  }
+  function pomoHtml() {
+    const P = pomo(A.S.tasks, today()), mx = Math.max(30, ...P.days.map((d) => d.m)), d = P.week - P.prev;
+    return `<div class="bd-stats"><div><b>${dur(P.today)}</b><span>today · ${P.rounds} task${P.rounds === 1 ? '' : 's'}</span></div><div><b>${dur(P.week)}</b><span>this week${P.prev ? ` · ${d >= 0 ? '+' : '-'}${dur(Math.abs(d))} vs last` : ''}</span></div><div><b>${dur(P.avg14)}</b><span>a day, 14 days</span></div></div>`
+      + `<div class="bd-bars" role="img" aria-label="Focus minutes, last 14 days">${P.days.map((x) => `<i class="${x.k === today() ? 'cur' : ''}" style="--h:${Math.round(x.m / mx * 100)}%" title="${esc(x.k)}: ${dur(x.m)}"></i>`).join('')}</div>`
+      + (P.best.m ? `<p class="bd-note">Best day: ${esc(dOf(P.best.k).toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' }))}, ${dur(P.best.m)}.</p>` : '<p class="bd-note">No focus rounds logged in 14 days. One 25-minute round in Focus mode starts the chart.</p>')
+      + (P.byProj.length ? `<p class="bd-note">By project: ${P.byProj.map((x) => `${esc(x.name)} ${dur(x.m)}`).join(' · ')}</p>` : '');
+  }
+  function todayFirst() { const w = dlg && dlg.querySelector('.bd-week'), c = w && w.querySelector('.bd-col.today'); if (c) w.scrollLeft = Math.max(0, c.offsetLeft - 8); }      // today's column is the first one you see
+  function paint() {
+    if (!dlg) return;
+    dlg.querySelector('#bdPlan').innerHTML = planHtml();
+    dlg.querySelector('#bdWeek').innerHTML = weekHtml();
+    if (dlg.open) todayFirst();
+    dlg.querySelector('#bdHeat').innerHTML = heatHtml();
+    dlg.querySelector('#bdPomo').innerHTML = pomoHtml();
+    const sub = dlg.querySelector('#bdSub'); if (sub) sub.textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
+  }
+  function open(where) {
+    if (!dlg) {
+      document.body.insertAdjacentHTML('beforeend', `<dialog id="bdBoard" class="bd" aria-label="The Board"><div class="bd-bg" aria-hidden="true"><i></i><i></i></div>
+        <button type="button" class="bd-x" data-bd="close" aria-label="Close the Board"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
+        <div class="bd-in" tabindex="-1"><header><h2>The Board</h2><p id="bdSub"></p></header>
+        <section class="bd-card" id="bdPlanCard" aria-label="Plan my day"><h3>Plan my day</h3><div id="bdPlan"></div></section>
+        <section class="bd-card" id="bdWeekCard" aria-label="Week board"><h3>Week board</h3><div id="bdWeek"></div></section>
