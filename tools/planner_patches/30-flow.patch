+// ===== FLOW: Workload, Deadline risk, Daily goal (ext-flow.js; docs/features-flow.md; tests/flow.test.js) =====
+// What Sunsama, Motion and Todoist have and the Planner lacked (2026-11-03):
+//  - Workload (Sunsama's "you planned more than you can do"): today's task estimates against the free time left today, a bar,
+//    and Trim to fit: the lowest-priority tasks move to tomorrow (preview first, Apply, Undo).
+//  - Deadline risk (Motion's "at risk"): tasks dated in the next 14 days, earliest date first, against 60% of each day's free
+//    time. A task whose date comes before there is time for it (and everything due before it) is at risk; Block time puts it
+//    in the best free gap before its date.
+//  - Daily goal (Todoist's Karma goal): tasks done today against a goal you pick, the run of days in a row, the last 7 days.
+// Loaded in <head>; waits for 'planner:ready' (window.PlannerAPI, the EXT API block in index.html). Changes to tasks and events go
+// through snapshot() + commit() like the app's own sheets (sync stamps, tombstones, Undo). Own data: the device key
+// planner.flow.goal (the daily goal, 1-10). Nothing existing is renamed, migrated or removed.
+(function () {
+  'use strict';
+  const GOAL_KEY = 'planner.flow.goal', GOAL_DEF = 3, GOAL_MAX = 10;
+  const DAY_FROM = 7 * 60, DAY_TO = 22 * 60, SHARE = 0.6, HORIZON = 14, EST_DEF = 30;
+  const HASHES = { workload: () => wlOpen(), deadlines: () => drOpen(), 'daily-goal': () => dgOpen() };
+  let A = null, wanted = '';
+
+  // ---------- deep links: read before the app's router clears the address ----------
+  const readHash = () => { try { const h = decodeURIComponent(location.hash.replace(/^#\/?/, '')).trim(); return Object.prototype.hasOwnProperty.call(HASHES, h) ? h : ''; } catch (e) { return ''; } };
+  wanted = readHash();
+  addEventListener('hashchange', () => { const h = readHash(); if (!h) return; if (A) setTimeout(() => runHash(h), 0); else wanted = h; });
+  function runHash(h) { try { A.goToday(); HASHES[h](); } catch (e) { console.error('Planner flow link:', e); } }
+
+  // ---------- small helpers (local dates as YYYY-MM-DD, minutes since midnight) ----------
+  const p2 = (n) => String(n).padStart(2, '0');
+  const kOf = (d) => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
+  const dOf = (k) => { const [y, m, d] = k.split('-').map(Number); return new Date(y, m - 1, d); };
+  const plus = (k, n) => { const d = dOf(k); d.setDate(d.getDate() + n); return kOf(d); };
+  const today = () => kOf(new Date());
+  const WDN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+  const MON3 = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  const dur = (m) => { m = Math.max(0, Math.round(m)); return m >= 60 ? `${Math.floor(m / 60)}h${m % 60 ? ' ' + (m % 60) + 'm' : ''}` : `${m}m`; };
+  const t12 = (m) => { let h = Math.floor(m / 60) % 24; const mm = m % 60, ap = h < 12 ? 'am' : 'pm'; h = h % 12 || 12; return (mm ? `${h}:${p2(mm)}` : `${h}`) + ap; };
+  const dateTxt = (k) => { const d = dOf(k); return `${WDN[d.getDay()]} ${MON3[d.getMonth()]} ${d.getDate()}`; };
+  const dayTxt = (k, t) => (k === t ? 'today' : k === plus(t, 1) ? 'tomorrow' : dateTxt(k));
+  const hm = (m) => `${p2(Math.floor(m / 60))}:${p2(m % 60)}`;
+  const est = (x) => (+x.est > 0 ? +x.est : EST_DEF);
+  const prio = (x) => (+x.p > 0 ? +x.p : 0);
+  const isIdea = (x) => x.tag === 'idea' || /^Idea:/.test(x.title || '');
+  const open = (x) => !!x && !x.done && !isIdea(x);
+
+  // ---------- the app's time: free gaps of a day (7am-10pm, shifts, events and travel out; today from now) ----------
+  function gapsOf(k) {
+    try { const trv = (A.bfSpans(k) || []).map((x) => [x.s, x.e]); return A.freeGaps(k, DAY_FROM, DAY_TO, 15, trv); } catch (e) { return []; }
+  }
+  const freeOf = (k) => gapsOf(k).reduce((a, [s, e]) => a + (e - s), 0);
+  // a task already time-blocked on a day is busy time there, never counted twice
+  const blockedOn = (S, id, k) => S.events.some((e) => e && e.taskId === id && e.date === k);
+
+  // =====================================================================================================================
+  // Pure planning (window.__fl for the tests): no DOM, no app state.
+  // =====================================================================================================================
+  // trim(tasks, free) -> { keep, move, used, need }: highest priority first, then oldest, each kept while it still fits.
+  function trim(tasks, free) {
+    const order = tasks.slice().sort((a, b) => (prio(b) - prio(a)) || ((a.created || 0) - (b.created || 0)));
+    const keep = [], move = []; let used = 0;
+    order.forEach((x) => { if (used + est(x) <= free) { keep.push(x); used += est(x); } else move.push(x); });
+    return { keep, move, used, need: tasks.reduce((a, x) => a + est(x), 0) };
+  }
+  // risk(tasks, days) with days [{ k, cap }] (cap in minutes, in date order from today): earliest date first (then priority), the
+  // running need against the running capacity up to each task's date -> [{ t, need, cum, room, short }] for the tasks at risk.
+  // Tasks dated on the first day use up capacity but are Workload's to report; risk names the later ones.
+  function risk(tasks, days) {
+    if (!days.length) return [];
+    const capTo = {}; let c = 0;
+    days.forEach((d) => { c += Math.max(0, d.cap); capTo[d.k] = c; });
+    const first = days[0].k, last = days[days.length - 1].k;
+    const order = tasks.filter((x) => x.date && x.date >= first && x.date <= last)
+      .sort((a, b) => a.date.localeCompare(b.date) || (prio(b) - prio(a)) || ((a.created || 0) - (b.created || 0)));
+    const out = []; let cum = 0;
+    order.forEach((x) => { cum += est(x); const room = capTo[x.date] || 0; if (cum > room && x.date > first) out.push({ t: x, need: est(x), cum, room, short: cum - room }); });
+    return out;
+  }
+  // goal(doneDays, t, goal) with doneDays { 'YYYY-MM-DD': n }: { done, goal, met, streak, week: [{ k, n }] (7 days, oldest first) }.
+  // The run counts back from today when today's goal is met, else from yesterday (it is never lost before the day is over).
+  function goal(doneDays, t, g) {
+    const n = (k) => doneDays[k] || 0, met = n(t) >= g;
+    let streak = 0, k = met ? t : plus(t, -1);
+    for (let i = 0; i < 3660 && n(k) >= g; i++) { streak++; k = plus(k, -1); }
+    const week = []; for (let i = 6; i >= 0; i--) { const d = plus(t, -i); week.push({ k: d, n: n(d) }); }
+    return { done: n(t), goal: g, met, streak, week };
+  }
+
+  // =====================================================================================================================
+  // Workload
+  // =====================================================================================================================
+  function wlState() {
+    const S = A.S, t = today(), list = S.tasks.filter((x) => open(x) && x.date === t && !blockedOn(S, x.id, t));
+    const free = freeOf(t), need = list.reduce((a, x) => a + est(x), 0);
+    return { t, list, free, need, over: need - free };
+  }
+  function wlBar(st) {
+    const max = Math.max(st.need, st.free, 1), w = (m) => ((m / max) * 100).toFixed(1);
+    return `<div class="fx-bar" role="img" aria-label="${esc(`${dur(st.need)} of tasks planned, ${dur(st.free)} free`)}"><i class="fx-free" style="width:${w(st.free)}%"></i><i class="fx-need${st.over > 0 ? ' over' : ''}" style="width:${w(st.need)}%"></i><b class="fx-cap" style="left:${w(st.free)}%" title="free time ends here"></b></div>`;
+  }
+  function wlLine(st) {
+    if (!st.list.length) return st.free ? `Nothing planned yet · <b>${dur(st.free)}</b> free today` : 'Nothing planned and no free time left today.';
+    return st.over > 0 ? `<b>${dur(st.need)}</b> of tasks, <b>${dur(st.free)}</b> free: <span class="fx-red">over by ${dur(st.over)}</span>`
+      : `<b>${dur(st.need)}</b> of tasks, <b>${dur(st.free)}</b> free · <span class="fx-ok">${dur(-st.over)} to spare</span>`;
+  }
+  function wlCard() {
+    const st = wlState();
+    if (!st.list.length && st.free <= 0) return '';
+    return `<section class="td-card fx-card" id="flWork"><h3>Workload<button type="button" data-flopen="workload">${st.over > 0 ? 'Trim' : 'More'}</button></h3>${wlBar(st)}<div class="fx-line" role="status">${wlLine(st)}</div></section>`;
+  }
+  const wlSum = () => { const st = wlState(); return st.list.length ? (st.over > 0 ? `over by ${dur(st.over)}` : `${dur(st.need)} planned, ${dur(st.free)} free`) : 'nothing planned'; };
+  let wlDlg = null, wlPlan = null;
+  function wlPaint() {
+    if (!wlDlg) return;
+    const st = wlState(), r = trim(st.list, st.free), body = wlDlg.querySelector('#flWlDlgB');
+    wlPlan = r.move.map((x) => x.id);
+    const row = (x) => { const pj = A.projOf(x.proj); return `<li><b>${esc(x.title)}</b><small>${esc([dur(est(x)) + (+x.est > 0 ? '' : ' (guess)'), x.p === 3 ? 'high priority' : x.p === 2 ? 'medium' : '', pj ? pj.name : ''].filter(Boolean).join(' · '))}</small></li>`; };
+    const moving = r.move.reduce((a, x) => a + est(x), 0);
+    body.innerHTML = `${wlBar(st)}<div class="fx-line">${wlLine(st)}</div>
+      <div class="hint">Free time is 7am to 10pm from now, after shifts, events, travel and time blocks. A task without an estimate counts as ${EST_DEF} minutes.</div>
+      ${r.keep.length ? `<div class="fx-h">Fits today · ${dur(r.used)}</div><ul class="fx-ul">${r.keep.map(row).join('')}</ul>` : ''}
+      ${r.move.length ? `<div class="fx-h">Move to tomorrow · ${dur(moving)}</div><ul class="fx-ul fx-mv">${r.move.map(row).join('')}</ul>` : ''}
+      <div class="dlg-f"><div class="sub">${r.move.length ? 'Lowest priority first. Nothing changes until Apply.' : st.list.length ? 'Everything fits. Nice.' : 'Nothing planned today.'}</div><div style="display:flex;gap:8px"><button type="button" class="btn" data-close>${r.move.length ? 'Cancel' : 'Done'}</button>${r.move.length ? '<button type="button" class="btn primary" id="flWlApply">Apply</button>' : ''}</div></div>`;
+  }
+  function wlOpen() { if (!wlDlg) wlDlg = A.makeDlg('flWlDlg', 'Workload today'); wlPaint(); if (!wlDlg.open) wlDlg.showModal(); }
+  function wlApply() {
+    const ids = wlPlan || [], S = A.S, to = plus(today(), 1); let n = 0;
+    if (!ids.length) return;
+    A.snapshot();
+    A.commit(() => { ids.forEach((id) => { const x = S.tasks.find((y) => y && y.id === id); if (x && !x.done) { x.date = to; n++; } }); });
+    wlDlg.close(); wlPlan = null; A.render();
+    A.toast(`Moved ${n} task${n === 1 ? '' : 's'} to tomorrow`, true);
+  }
+
+  // =====================================================================================================================
+  // Deadline risk
+  // =====================================================================================================================
+  function drState() {
+    const S = A.S, t = today(), days = [];
+    for (let i = 0; i < HORIZON; i++) { const k = plus(t, i); days.push({ k, cap: Math.round(freeOf(k) * SHARE) }); }
+    // a task with a time block between today and its date is planned: it is never at risk
+    const list = S.tasks.filter((x) => open(x) && x.date && !S.events.some((e) => e && e.taskId === x.id && e.date >= t && e.date <= x.date));
+    return { t, days, at: risk(list, days) };
+  }
+  function drCard() {
+    const st = drState(); if (!st.at.length) return '';
+    const f = st.at[0], when = esc(dayTxt(f.t.date, st.t));
+    const line = st.at.length === 1 ? `${esc(f.t.title)} may miss ${when}` : `${st.at.length} tasks may miss their date, first ${esc(f.t.title)} (${when})`;
+    return `<section class="td-card fx-card" id="flRisk"><div class="fx-row"><div><b>Deadline risk</b><div class="sub">${line}</div></div><button type="button" class="btn sm primary" data-flopen="deadlines">Fix</button></div></section>`;
+  }
+  const drSum = () => { const n = drState().at.length; return n ? `${n} at risk` : 'all on time'; };
+  let drDlg = null;
+  // the best free gap on or before the task's date: the first that holds it all, else the longest
+  function drSlot(x, t) {
+    let best = null;
+    for (let k = t; k <= x.date; k = plus(k, 1)) {
+      for (const [s, e] of gapsOf(k)) {
+        const g = { k, s, len: e - s };
+        if (g.len >= est(x)) return g;
+        if (!best || g.len > best.len) best = g;
+      }
+    }
+    return best;
+  }
+  function drPaint() {
+    if (!drDlg) return;
+    const st = drState(), body = drDlg.querySelector('#flDrDlgB');
+    if (!st.at.length) { body.innerHTML = '<div class="empty-s">Every dated task has time before its date. Nice.</div><div class="dlg-f"><div></div><div><button type="button" class="btn primary" data-close>Done</button></div></div>'; return; }
+    body.innerHTML = `<div class="hint">Earliest date first, against 60% of each day's free time (7am to 10pm, after shifts, events and travel). A task without an estimate counts as ${EST_DEF} minutes.</div>
+      <ul class="fx-ul fx-risk">${st.at.map((r) => {
+        const g = drSlot(r.t, st.t), where = g ? `${dayTxt(g.k, st.t)} ${t12(g.s)}, ${dur(Math.min(r.need, g.len))}` : '';
+        return `<li data-flt="${esc(r.t.id)}"><div><b>${esc(r.t.title)}</b><small>${esc(`due ${dayTxt(r.t.date, st.t)} · needs ${dur(r.need)} · ${dur(r.short)} short with everything due before it`)}</small></div>
+          <div class="fx-acts">${g ? `<button type="button" class="btn sm primary" data-flblock>Block ${esc(where)}</button>` : ''}<button type="button" class="btn sm" data-fldetail>Open</button></div></li>`;
+      }).join('')}</ul>
+      <div class="dlg-f"><div class="sub">Or open a task to move its date or cut its estimate.</div><div><button type="button" class="btn" data-close>Close</button></div></div>`;
+  }
+  function drOpen() { if (!drDlg) drDlg = A.makeDlg('flDrDlg', 'Deadline risk'); drPaint(); if (!drDlg.open) drDlg.showModal(); }
+  function drBlock(id) {
+    const S = A.S, x = S.tasks.find((y) => y && y.id === id); if (!x) return;
+    const g = drSlot(x, today()); if (!g) { A.toast('No free time before its date'); return; }
+    const len = Math.min(est(x), g.len);
+    A.snapshot();
+    A.commit(() => {
+      S.events.push({ id: A.uid(), title: x.title, cat: S.lastCat, date: g.k, allDay: false, start: hm(g.s), end: hm(g.s + len), endDate: '', repeat: 'none', until: '', notes: x.notes || '', ex: [], proj: x.proj || '', taskId: x.id, created: Date.now() });
+    });
+    A.render(); drPaint();
+    A.toast(`Blocked ${dur(len)} ${dayTxt(g.k, today())} at ${t12(g.s)}: ${x.title}`, true);
+  }
+
+  // =====================================================================================================================
+  // Daily goal
+  // =====================================================================================================================
+  const goalGet = () => { try { const g = parseInt(localStorage.getItem(GOAL_KEY), 10); return g >= 1 && g <= GOAL_MAX ? g : GOAL_DEF; } catch (e) { return GOAL_DEF; } };
+  const goalSet = (g) => { try { localStorage.setItem(GOAL_KEY, String(g)); } catch (e) { /* this phone only, a convenience */ } };
+  function doneDays() {
+    const out = {};
+    A.S.tasks.forEach((x) => { if (x && x.done && +x.doneAt > 0) { const k = kOf(new Date(+x.doneAt)); out[k] = (out[k] || 0) + 1; } });
+    return out;
+  }
+  const dgState = () => goal(doneDays(), today(), goalGet());
+  function dgHtml(st, inSheet) {
+    const pc = Math.min(1, st.done / st.goal), R = 22, C = 2 * Math.PI * R;
+    const ring = `<svg class="fx-ring" viewBox="0 0 54 54" aria-hidden="true"><circle cx="27" cy="27" r="${R}" class="bg"/><circle cx="27" cy="27" r="${R}" class="fg${st.met ? ' met' : ''}" stroke-dasharray="${(pc * C).toFixed(1)} ${C.toFixed(1)}" transform="rotate(-90 27 27)"/><text x="27" y="31" text-anchor="middle">${st.done}/${st.goal}</text></svg>`;
+    const mx = Math.max(st.goal, ...st.week.map((d) => d.n), 1);
+    const bars = `<div class="fx-wk" role="img" aria-label="${esc('Tasks done, last 7 days: ' + st.week.map((d) => d.n).join(', '))}">${st.week.map((d) => `<span title="${esc(d.k + ': ' + d.n)}"><i class="${d.n >= st.goal ? 'met' : ''}" style="height:${Math.max(4, (d.n / mx) * 100).toFixed(0)}%"></i><em>${WDN[dOf(d.k).getDay()][0]}</em></span>`).join('')}</div>`;
+    const run = (n) => `${n} day${n === 1 ? '' : 's'} in a row`;
+    const line = st.met ? `<b>Goal met.</b> ${run(st.streak)}` : `${st.goal - st.done} more to hit today's goal${st.streak ? ` · ${run(st.streak)} so far` : ''}`;
+    const pick = inSheet ? `<label class="fx-goal">Daily goal <select id="flGoal" aria-label="Tasks a day">${Array.from({ length: GOAL_MAX }, (_, i) => i + 1).map((n) => `<option value="${n}"${n === st.goal ? ' selected' : ''}>${n} task${n === 1 ? '' : 's'}</option>`).join('')}</select></label>` : '';
+    return `<div class="fx-dg">${ring}<div class="fx-dgt"><div class="fx-line" role="status">${line}</div>${bars}</div></div>${pick}`;
+  }
+  const dgCard = () => `<section class="td-card fx-card" id="flGoalCard"><h3>Daily goal<button type="button" data-flopen="daily-goal">Goal</button></h3>${dgHtml(dgState(), false)}</section>`;
+  const dgSum = () => { const st = dgState(); return `${st.done} of ${st.goal} done${st.streak ? ` · ${st.streak} day${st.streak === 1 ? '' : 's'} in a row` : ''}`; };
+  let dgDlg = null;
+  function dgPaint() { if (dgDlg) dgDlg.querySelector('#flDgDlgB').innerHTML = `${dgHtml(dgState(), true)}<div class="hint">Counted from the tasks you tick off each day; this phone keeps the goal. The run of days only grows on days you hit it.</div>`; }
+  function dgOpen() {
+    if (!dgDlg) {
+      dgDlg = A.makeDlg('flDgDlg', 'Daily goal');
+      dgDlg.addEventListener('change', (e) => { if (e.target.id === 'flGoal') { goalSet(+e.target.value); dgPaint(); if (A.S.view === 'today') A.renderMain(); } });
+    }
+    dgPaint(); if (!dgDlg.open) dgDlg.showModal();
+  }
+
+  // =====================================================================================================================
+  // Wiring: Today cards, All tools tiles, palette commands, styles
+  // =====================================================================================================================
+  function register() {
