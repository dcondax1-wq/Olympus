{"text": "<style>\n.le { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); max-width: 72rem; margin-inline: auto; }\n.le-head { display: grid; gap: var(--cds-gap-xs); }\n.le-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.le-take { color: var(--color-fg-muted); margin: 0; max-width: 62ch; }\n.le-status { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); width: fit-content; padding: var(--cds-pad-xs) var(--cds-pad-sm);\n  border: 1px solid var(--color-border-line); border-radius: 999px; font-size: var(--cds-font-size-caption); color: var(--color-warn); }\n.le-status::before { content: \"\"; width: .5rem; height: .5rem; border-radius: 50%; background: currentColor; }\n.le-kpis { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); }\n.le-kpi, .le-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.le-kpi { display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.le-k { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.le-v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.1; }\n.le-grid { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n.le-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.le-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); }\n.le-chart { position: relative; min-height: 240px; }\n.le-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius);\n  box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n.le-tip .d { color: var(--cds-text-secondary); }\n.le-bars { display: grid; gap: var(--cds-gap-md); min-height: 180px; }\n.le-bar-row { display: grid; gap: var(--cds-gap-xs); }\n.le-bar-top { display: flex; justify-content: space-between; gap: var(--cds-gap-sm); font-size: var(--cds-font-size-caption); }\n.le-bar-top .n { color: var(--color-fg-muted); }\n.le-bar-top .val { font-variant-numeric: tabular-nums; }\n.le-track { position: relative; height: 14px; }\n.le-track .zero { position: absolute; top: -3px; bottom: -3px; width: 1px; background: var(--cds-chart-axis); }\n.le-track .fill { position: absolute; top: 0; bottom: 0; border-radius: 4px; }\n.le-big { display: flex; flex-wrap: wrap; gap: var(--cds-gap-lg); align-items: baseline; }\n.le-big .le-v { font-size: var(--cds-font-size-title); }\n.le-tbl-wrap { overflow: auto; max-height: 26rem; }\n.le-tbl { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.le-tbl th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted);\n  padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.le-tbl td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.le-tbl td.num, .le-tbl th.num { text-align: right; }\n.le .up { color: var(--color-ok); }\n.le .dn { color: var(--color-bad); }\n.le-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.le-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.le-sec { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: var(--cds-gap-md) 0 0; }\n</style>\n\n<div class=\"le\">\n  <header class=\"le-head\" id=\"top\">\n    <h1>Liquidity Engine snapshot</h1>\n    <p class=\"le-take\">NQ futures backtest, <span data-source=\"summary\" data-field=\"period_from\" data-row=\"0\" class=\"dash-skeleton\">\u2014</span> to\n      <span data-source=\"summary\" data-field=\"period_to\" data-row=\"0\" class=\"dash-skeleton\">\u2014</span>. Strong on these weeks, but the same rules lost money in two other market periods, so the bot stays on paper until it is fixed across regimes.</p>\n    <span class=\"le-status\">Paper trading only</span>\n  </header>\n\n  <section class=\"le-kpis\" id=\"kpis\">\n    <div class=\"le-kpi\"><span class=\"le-k\">Net P&amp;L at $350 risk</span><span class=\"le-v dash-skeleton\" id=\"k-net\" data-source=\"summary\" data-field=\"net_pnl\" data-row=\"0\">\u2014</span></div>\n    <div class=\"le-kpi\"><span class=\"le-k\">Win rate</span><span class=\"le-v dash-skeleton\" id=\"k-wr\" data-source=\"summary\" data-field=\"win_rate\" data-row=\"0\">\u2014</span></div>\n    <div class=\"le-kpi\"><span class=\"le-k\">Profit factor</span><span class=\"le-v dash-skeleton\" id=\"k-pf\" data-source=\"summary\" data-field=\"profit_factor\" data-row=\"0\">\u2014</span></div>\n    <div class=\"le-kpi\"><span class=\"le-k\">Trades per week</span><span class=\"le-v dash-skeleton\" id=\"k-tpw\" data-source=\"summary\" data-field=\"trades_per_week\" data-row=\"0\">\u2014</span></div>\n    <div class=\"le-kpi\"><span class=\"le-k\">Max drawdown</span><span class=\"le-v dash-skeleton\" id=\"k-dd\" data-source=\"summary\" data-field=\"max_drawdown\" data-row=\"0\">\u2014</span></div>\n    <div class=\"le-kpi\"><span class=\"le-k\">Avg days to pass the eval</span><span class=\"le-v dash-skeleton\" id=\"k-days\" data-source=\"summary\" data-field=\"eval_avg_days\" data-row=\"0\">\u2014</span></div>\n  </section>\n\n  <section class=\"le-card\" id=\"equity\">\n    <h2>Simulated MFFU Builder 50K account</h2>\n    <p class=\"le-note\">End-of-day balance against the trailing max-loss line and the $53,000 pass target.</p>\n    <div class=\"le-chart\" id=\"eq-chart\" data-source=\"equity\"></div>\n  </section>\n\n  <h2 class=\"le-sec\" id=\"robustness\">Does it hold up?</h2>\n  <div class=\"le-grid\">\n    <section class=\"le-card\" id=\"periods\">\n      <h2>Average result per trade by period</h2>\n      <p class=\"le-note\">R = multiples of the amount risked. Periods marked unseen were never used to tune the rules.</p>\n      <div class=\"le-bars\" id=\"period-bars\" data-source=\"periods\"></div>\n    </section>\n    <section class=\"le-card\" id=\"placebo\">\n      <h2>Better than random entries?</h2>\n      <p class=\"le-note\">500 fake strategies traded at random times and sides with the same stops, targets and management.</p>\n      <div class=\"le-big\">\n        <div><div class=\"le-k\">Real strategy</div><div class=\"le-v dash-skeleton\" id=\"p-real\" data-source=\"placebo\" data-field=\"real_avg_r\" data-row=\"0\">\u2014</div></div>\n        <div><div class=\"le-k\">Random average</div><div class=\"le-v dash-skeleton\" id=\"p-mean\" data-source=\"placebo\" data-field=\"placebo_mean_r\" data-row=\"0\">\u2014</div></div>\n        <div><div class=\"le-k\">Best 1% of random</div><div class=\"le-v dash-skeleton\" id=\"p-top\" data-source=\"placebo\" data-field=\"placebo_top1pct_r\" data-row=\"0\">\u2014</div></div>\n      </div>\n      <p class=\"le-note\" style=\"margin-top: var(--cds-gap-md)\">Chance a random strategy does as well: <b id=\"p-p\" data-source=\"placebo\" data-field=\"p_value\" data-row=\"0\">\u2014</b>.\n        Likely range of the real average (90%): <b id=\"p-lo\" data-source=\"placebo\" data-field=\"ci90_low\" data-row=\"0\">\u2014</b> to <b id=\"p-hi\" data-source=\"placebo\" data-field=\"ci90_high\" data-row=\"0\">\u2014</b>.\n        This holds for the NQ futures weeks only.</p>\n    </section>\n  </div>\n\n  <section class=\"le-card\" id=\"modes\">\n    <h2>Evaluation modes</h2>\n    <p class=\"le-note\">Pass odds from 3,000 simulated 60-day evals built from the backtested days; rolling counts start an eval on every historical day.</p>\n    <div class=\"le-tbl-wrap\">\n      <table class=\"le-tbl\" data-source=\"modes\" data-row-key=\"mode\">\n        <thead><tr><th data-field=\"mode\">Mode</th><th class=\"num\" data-field=\"mc_pass\">Pass odds</th><th class=\"num\" data-field=\"median_days\">Median days</th>\n          <th class=\"num\" data-field=\"rolling_passed\">Rolling passed</th><th class=\"num\" data-field=\"rolling_failed\">Rolling failed</th><th class=\"num\" data-field=\"net_pnl\">Net P&amp;L</th></tr></thead>\n        <tbody id=\"modes-body\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"le-card\" id=\"trades\">\n    <h2>Trade log</h2>\n    <p class=\"le-note\">Every backtested trade, newest first. Times are New York.</p>\n    <div class=\"le-tbl-wrap\">\n      <table class=\"le-tbl\" data-source=\"trades\" data-row-key=\"trade_id\">\n        <thead><tr><th data-field=\"trade_id\">Entry</th><th data-field=\"side\">Side</th><th data-field=\"trigger\">Trigger</th><th data-field=\"target\">Target</th>\n          <th data-field=\"exit\">Exit</th><th class=\"num\" data-field=\"r_multiple\">R</th><th class=\"num\" data-field=\"pnl\">P&amp;L</th></tr></thead>\n        <tbody id=\"trades-body\"></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\n(function () {\n  const TARGET = 53000;\n  const money = (v) => (v < 0 ? '-$' : '$') + d3.format(',.0f')(Math.abs(v));\n  const smoney = (v) => (v > 0 ? '+' : '') + money(v);\n  const rfmt = (v) => (v > 0 ? '+' : '') + d3.format('.2f')(v) + 'R';\n  const pct = d3.format('.1%');\n  const cls = (v) => (v > 0 ? 'up' : v < 0 ? 'dn' : '');\n\n  function put(id, text, c) {\n    const el = document.getElementById(id);\n    if (!el) return;\n    el.textContent = text;\n    el.classList.remove('dash-skeleton', 'up', 'dn');\n    if (c) el.classList.add(c);\n  }\n  function fail(el) {\n    el.innerHTML = '';\n    const d = document.createElement('div');\n    d.className = 'le-fail';\n    d.textContent = 'Failed to load';\n    el.appendChild(d);\n  }\n\n  function summary() {\n    const S = dash.data('summary');\n    const ids = ['k-net', 'k-wr', 'k-pf', 'k-tpw', 'k-dd', 'k-days'];\n    document.querySelectorAll('[data-source=\"summary\"][data-field^=\"period\"]').forEach((el) => {\n      if (S.status === 'ok' && S.data.length) { el.textContent = d3.utcFormat('%b %-d, %Y')(new Date(S.data[0][el.dataset.field] + 'T12:00:00Z')); el.classList.remove('dash-skeleton'); }\n      else el.textContent = '\u2014';\n    });\n    if (S.status !== 'ok' || !S.data.length) { ids.forEach((i) => put(i, '\u2014')); return; }\n    const r = S.data[0];\n    put('k-net', smoney(+r.net_pnl), cls(+r.net_pnl));\n    put('k-wr', pct(+r.win_rate));\n    put('k-pf', d3.format('.2f')(+r.profit_factor), +r.profit_factor >= 1 ? 'up' : 'dn');\n    put('k-tpw', d3.format('.1f')(+r.trades_per_week));\n    put('k-dd', money(+r.max_drawdown), 'dn');\n    put('k-days', d3.format('.1f')(+r.eval_avg_days));\n  }\n\n  function equity() {\n    const box = document.getElementById('eq-chart');\n    box.innerHTML = '';\n    const D = dash.data('equity');\n    if (D.status === 'error') { fail(box); return; }\n    if (D.status !== 'ok' || !D.data.length) return;\n    const rows = D.data.map((r) => ({ day: new Date(r.day + 'T12:00:00Z'), bal: +r.balance, mll: +r.trailing_mll }));\n    const W = Math.max(280, box.clientWidth), H = 240, m = { t: 14, r: 64, b: 26, l: 44 };\n    const lo = d3.min(rows, (d) => Math.min(d.bal, d.mll)), hi = Math.max(d3.max(rows, (d) => d.bal), TARGET);\n    const x = d3.scaleUtc(d3.extent(rows, (d) => d.day), [m.l, W - m.r]);\n    const y = d3.scaleLinear([lo - 400, hi + 400], [H - m.b, m.t]).nice();\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).style('display', 'block');\n    svg.append('g').selectAll('line').data(y.ticks(5)).join('line')\n      .attr('x1', m.l).attr('x2', W - m.r).attr('y1', y).attr('y2', y).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').attr('transform', `translate(0,${H - m.b})`)\n      .call(d3.axisBottom(x).ticks(Math.max(2, Math.floor(W / 110))).tickFormat(d3.utcFormat('%b %-d')).tickSizeOuter(0))\n      .attr('font-size', null).attr('font-family', null)\n      .call((g) => g.selectAll('text').attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)'))\n      .call((g) => g.selectAll('line,path').attr('stroke', 'var(--cds-chart-axis)'));\n    svg.append('g').selectAll('text').data(y.ticks(5)).join('text')\n      .attr('x', m.l - 6).attr('y', y).attr('dy', '0.32em').attr('text-anchor', 'end')\n      .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)')\n      .text((v) => '$' + d3.format('.0f')(v / 1000) + 'k');\n    svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(TARGET)).attr('y2', y(TARGET))\n      .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 4');\n    const line = (f) => d3.line().x((d) => x(d.day)).y((d) => y(f(d)));\n    svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', 'var(--cds-chart-status-critical)').attr('stroke-width', 1.5)\n      .attr('stroke-dasharray', '5 4').attr('d', line((d) => d.mll));\n    svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', dash.colors[0]).attr('stroke-width', 2)\n      .attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round').attr('d', line((d) => d.bal));\n    const last = rows[rows.length - 1];\n    const lab = (txt, yy, col) => svg.append('text').attr('x', W - m.r + 6).attr('y', yy).attr('dy', '0.32em')\n      .attr('fill', col).style('font-size', 'var(--cds-font-size-caption)').text(txt);\n    let yb = y(last.bal), ym = y(last.mll), yt = y(TARGET);\n    if (Math.abs(yb - yt) < 13) yt = yb + (yt >= yb ? 13 : -13);\n    lab(money(last.bal), yb, 'var(--color-fg)');\n    lab('Target', yt, 'var(--color-fg-muted)');\n    lab('Max loss', Math.max(ym, yt + 13), 'var(--color-fg-muted)');\n    // tooltip\n    const tip = d3.select(box).append('div').attr('class', 'le-tip').style('display', 'none');\n    const dot = svg.append('circle').attr('r', 4).attr('fill', dash.colors[0]).style('display', 'none');\n    const bis = d3.bisector((d) => d.day).center;\n    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b)\n      .attr('fill', 'transparent')\n      .on('pointermove', (ev) => {\n        const [px] = d3.pointer(ev);\n        const d = rows[bis(rows, x.invert(px))];\n        const sx = box.clientWidth / W;\n        dot.style('display', null).attr('cx', x(d.day)).attr('cy', y(d.bal));\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'd').text(d3.utcFormat('%a %b %-d')(d.day));\n        tip.append('div').text('Balance ' + money(d.bal));\n        tip.append('div').text('Max-loss line ' + money(d.mll));\n        const tw = tip.node().offsetWidth;\n        tip.style('left', Math.min(box.clientWidth - tw - 4, Math.max(4, x(d.day) * sx + 10)) + 'px').style('top', '8px');\n      })\n      .on('pointerleave', () => { tip.style('display', 'none'); dot.style('display', 'none'); });\n  }\n\n  function periods() {\n    const box = document.getElementById('period-bars');\n    box.innerHTML = '';\n    const D = dash.data('periods');\n    if (D.status === 'error') { fail(box); return; }\n    if (D.status !== 'ok') return;\n    const rows = D.data.map((r) => ({ ...r, avg_r: +r.avg_r, trades: +r.trades, win_rate: +r.win_rate }));\n    const ext = Math.max(0.5, d3.max(rows, (r) => Math.abs(r.avg_r)));\n    const x = d3.scaleLinear([-ext, ext], [0, 100]);\n    rows.forEach((r) => {\n      const row = document.createElement('div');\n      row.className = 'le-bar-row';\n      const top = document.createElement('div');\n      top.className = 'le-bar-top';\n      const name = document.createElement('span');\n      name.textContent = r.period;\n      const val = document.createElement('span');\n      val.className = 'val ' + cls(r.avg_r);\n      val.textContent = rfmt(r.avg_r) + ' \u00b7 ' + r.trades + ' trades \u00b7 ' + pct(r.win_rate) + ' wins';\n      top.append(name, val);\n      const sub = document.createElement('div');\n      sub.className = 'le-bar-top';\n      const role = document.createElement('span');\n      role.className = 'n';\n      role.textContent = r.role + ' \u00b7 ' + r.data;\n      sub.append(role);\n      const track = document.createElement('div');\n      track.className = 'le-track';\n      const z = document.createElement('div');\n      z.className = 'zero'; z.style.left = x(0) + '%';\n      const f = document.createElement('div');\n      f.className = 'fill';\n      const a = x(Math.min(0, r.avg_r)), b = x(Math.max(0, r.avg_r));\n      f.style.left = a + '%'; f.style.width = Math.max(0.5, b - a) + '%';\n      f.style.background = r.avg_r >= 0 ? dash.colors[0] : 'var(--cds-chart-status-critical)';\n      track.append(f, z);\n      row.append(top, sub, track);\n      box.appendChild(row);\n    });\n  }\n\n  function placebo() {\n    const P = dash.data('placebo');\n    const ids = ['p-real', 'p-mean', 'p-top', 'p-p', 'p-lo', 'p-hi'];\n    if (P.status !== 'ok' || !P.data.length) { ids.forEach((i) => put(i, '\u2014')); return; }\n    const r = P.data[0];\n    put('p-real', rfmt(+r.real_avg_r), cls(+r.real_avg_r));\n    put('p-mean', rfmt(+r.placebo_mean_r), cls(+r.placebo_mean_r));\n    put('p-top', rfmt(+r.placebo_top1pct_r));\n    put('p-p', +r.p_value < 0.001 ? 'under 0.1%' : pct(+r.p_value));\n    put('p-lo', rfmt(+r.ci90_low));\n    put('p-hi', rfmt(+r.ci90_high));\n  }\n\n  function table(bodyId, id, cols) {\n    const body = document.getElementById(bodyId);\n    body.innerHTML = '';\n    const D = dash.data(id);\n    if (D.status !== 'ok') return;\n    D.data.forEach((r) => {\n      const tr = document.createElement('tr');\n      cols.forEach(([k, f, num]) => {\n        const td = document.createElement('td');\n        if (num) td.className = 'num';\n        const v = f ? f(r[k], r) : r[k];\n        td.textContent = v;\n        if (k === 'r_multiple' || k === 'pnl' || k === 'net_pnl') td.classList.add(cls(+r[k]));\n        tr.appendChild(td);\n      });\n      body.appendChild(tr);\n    });\n  }\n\n  dash.onData(() => {\n    summary();\n    equity();\n    periods();\n    placebo();\n    table('modes-body', 'modes', [['mode'], ['mc_pass', (v) => pct(+v), 1], ['median_days', (v) => d3.format('.0f')(+v), 1],\n      ['rolling_passed', null, 1], ['rolling_failed', null, 1], ['net_pnl', (v) => smoney(+v), 1]]);\n    table('trades-body', 'trades', [['trade_id'], ['side'], ['trigger'], ['target'], ['exit'], ['r_multiple', (v) => rfmt(+v), 1], ['pnl', (v) => smoney(+v), 1]]);\n    const body = document.getElementById('trades-body');\n    [...body.children].reverse().forEach((tr) => body.appendChild(tr));\n  });\n})();\n</script>\n"}