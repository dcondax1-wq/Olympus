From a8ffad1944e5e77034e4d7cfb791ac715c8fe241 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 05:43:52 +0000
Subject: [PATCH] live_guard (night-missedalarm, for red team): an unarmed
 account = ONE 'is not armed: it missed ... Arm it at the PC' line a day, with
 ~$ at its size (its max risk a trade, else the twin's); size hint on every
 MISSED TRADE line; tests/test_missed_alarm

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EwJ4kRSR69qrCPiXjEreQU
---
 engine/live_guard.py       |  63 +++++++++++++++++++++-
 tests/test_missed_alarm.py | 106 +++++++++++++++++++++++++++++++++++++
 2 files changed, 167 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_missed_alarm.py

diff --git a/engine/live_guard.py b/engine/live_guard.py
index da595c14..ea058cad 100644
--- a/engine/live_guard.py
+++ b/engine/live_guard.py
@@ -292,18 +292,77 @@ def missed(bot, now) -> list:
     seen, uniq = set(), []
     for m in out:
         k = f"guard:miss:{m['model']}:{_mask(m['account'])}:{int(m['entry_t'])}"
+        if _not_armed(m.get("why")):                       # night-missedalarm: an unarmed account = ONE line a day (its first miss),
+            k = f"guard:miss:{m['model']}:{_mask(m['account'])}:{trading_day(m['entry_t'])}:notarmed"   # not one per signal
         if k not in seen:
             seen.add(k)
-            uniq.append({**m, "key": k})
+            uniq.append({**m, "key": k, **_size_hint(bot, m)})
     return uniq
 
 
+def _not_armed(why) -> bool:
+    w = str(why or "").lower()
+    return "not armed" in w
+
+
+def _size_hint(bot, m: dict) -> dict:
+    """{"side", "risk_usd", "r", "usd"} of a missed signal, estimated at the ACCOUNT's size where it is known (its max risk a trade,
+    engine/multi_account rules.max_risk_usd), else the twin's own risk. Read only; {} on any problem."""
+    try:
+        acct = None
+        for a in list(lit_followers(bot)) + list(atlas_accounts(bot)):
+            if _label(a) == m.get("account"):
+                acct = a
+                break
+        rules = (getattr(acct, "rules", None) or ((getattr(acct, "spec", None) or {}).get("rules")) or {}) if acct is not None else {}
+        cap = rules.get("max_risk_usd") if isinstance(rules, dict) else None
+        t = int(m["entry_t"])
+        if m.get("model") == "atlas":
+            tw = None
+            for tr in ((((getattr(bot, "second", None) or {}).get("strategies") or {}).get(m.get("key")) or {}).get("trades") or []):
+                if int(tr.get("entry_t") or 0) == t:
+                    tw = tr
+                    break
+            if not tw:
+                return {}
+            risk = float(cap or tw.get("risk_usd") or 0) or None
+            r = tw.get("r") if tw.get("r") is not None else tw.get("last_r")
+            side = "LONG" if int(tw.get("dir") or 0) > 0 else "SHORT"
+        else:
+            pos = (getattr(bot, "state", None) or {}).get("position") or {}
+            same = pos.get("entry_t") is not None and int(pos["entry_t"]) == t
+            risk = float(cap or (pos.get("risk_usd") if same else 0) or 0) or None
+            r = None
+            side = ("LONG" if pos.get("dir") == 1 else "SHORT") if same else ""
+        out = {"side": side, "risk_usd": round(risk, 2) if risk else None}
+        if risk and r is not None:
+            out.update(r=round(float(r), 2), usd=round(float(r) * risk, 2))
+        return out
+    except Exception:  # noqa: BLE001
+        return {}
+
+
+def _hint_words(m: dict) -> str:
+    if m.get("usd") is not None:
+        return f" (~{'+' if m['usd'] >= 0 else '-'}${abs(m['usd']):,.0f} at its size: {m['r']:+.1f}R on ~${m['risk_usd']:,.0f} risk)"
+    if m.get("risk_usd"):
+        return f" (~${m['risk_usd']:,.0f} risk at its size)"
+    return ""
+
+
 def missed_payload(m: dict) -> dict:
     who = "Zlarior" if m["model"] == "lit" else "ATLAS"
+    if _not_armed(m.get("why")) and not m.get("soft"):     # night-missedalarm: the owner's words, one a day per account
+        acct = _mask(m["account"])
+        return {"key": m["key"], "code": "missed", "bot": m["model"], "entry_t": int(m["entry_t"]),
+                "title": f"{acct} is not armed"[:120],
+                "body": (f"{acct} is not armed: it missed {who} "
+                         f"{(m.get('side') or '').lower() + ' ' if m.get('side') else ''}at {_hm(m['entry_t'])} ET{_hint_words(m)}. "
+                         "Arm it at the PC: STOP BOT, START_BOT.bat, type I ACCEPT LIVE RISK. (One line a day per account.)")[:600]}
     head = "Not taken (check)" if m.get("soft") else "MISSED TRADE"
     return {"key": m["key"], "code": "missed", "bot": m["model"], "entry_t": int(m["entry_t"]),
             "title": f"{head} · {who} {_hm(m['entry_t'])} ET on {_mask(m['account'])}"[:120],
-            "body": (f"The live twin took {who}'s {_hm(m['entry_t'])} ET entry; {_mask(m['account'])} did not: {_mask(m['why'])}."
+            "body": (f"The live twin took {who}'s {_hm(m['entry_t'])} ET entry; {_mask(m['account'])} did not: {_mask(m['why'])}{_hint_words(m)}."
                      + ("" if m.get("soft") else " Next: python tools/board.py read, then the account's line in the Start window."))[:600],
             **({"soft": True, "tags": "eyes"} if m.get("soft") else {})}
 
diff --git a/tests/test_missed_alarm.py b/tests/test_missed_alarm.py
new file mode 100644
index 00000000..8722ceca
--- /dev/null
+++ b/tests/test_missed_alarm.py
@@ -0,0 +1,106 @@
+"""night-missedalarm (2026-11-27, red team): engine/live_guard's missed-trade alarm, the not-armed case made the owner's words.
+  a. an UNARMED follower + a LIT signal -> ONE line "<account> is not armed: it missed Zlarior ... Arm it at the PC"
+  b. an ARMED follower that routed it -> nothing
+  c. a second signal the same day on the same unarmed account -> no second line (one a day per account); the next day -> a line again
+  d. ATLAS on the Rapid (max $250 risk a trade) missing the EMA +6.6R: "~+$1,659 at its size"
+  e. read only, never raises on junk, ids masked; the other miss reasons (refused, start problem) keep the old MISSED TRADE line
+    python -X utf8 -m tests.test_missed_alarm
+"""
+from __future__ import annotations
+
+import datetime as dt
+import os
+import sys
+import tempfile
+import types
+from zoneinfo import ZoneInfo
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from engine import live_guard as LG  # noqa: E402
+
+FAILS = []
+REAL = "MFFUEVR4441234"
+ET = ZoneInfo("America/New_York")
+
+
+def check(name, ok, info=""):
+    print(("[PASS] " if ok else "[FAIL] ") + name + ("" if ok else f"  -> {str(info)[:500]}"), flush=True)
+    if not ok:
+        FAILS.append(name)
+
+
+def ts(*a):
+    return int(dt.datetime(*a, tzinfo=ET).timestamp())
+
+
+def acct(name, armed, ledger=None, keys=None, rules=None, why=None):
+    return types.SimpleNamespace(spec={"adapter": "ninjatrader", "armed": armed, "nt_account": REAL, "name": name, "keys": keys or [],
+                                       "rules": rules or {}},
+                                 name=name, label=name, problem=None, adapter=object(), seen=set(), blocked=set(), hedge_wait=set(), held={},
+                                 added_t=0, open_t=None, closes=[], ledger=ledger or [], disabled_reason=lambda: why)
+
+
+def bot_with(accounts, entries, atlas=None, second=None, pos=None):
+    return types.SimpleNamespace(running=True, cfg={"adapter": "ninjatrader"}, seen={("entry", t) for t in entries}, state={"position": pos or {}},
+                                 accts=types.SimpleNamespace(accounts=accounts), acct_b=None, acct_r=atlas, acct_r2=None, kill=False,
+                                 second=second or {"strategies": {}})
+
+
+def pushes(bot, *nows):
+    got = []
+    g = LG.LiveGuard(send=lambda p: got.append(p) or "sent", state_path=os.path.join(tempfile.mkdtemp(), "lg.json"),
+                     au_path=os.path.join(tempfile.mkdtemp(), "none.json"))
+    for n in nows:
+        g._miss_t = 0
+        g.step(bot, n)
+    return [p for p in got if p.get("code") == "missed"]
+
+
+def main():
+    e1, e2 = ts(2026, 11, 24, 3, 40), ts(2026, 11, 24, 9, 50)
+    un = acct("Rapid EOD 25K", False)
+    ok = acct("Zlarior 25K #2", True, ledger=[{"side": "buy", "entry_t": e1, "result": {"ok": True}}])
+    b = bot_with([un], [e1], pos={"entry_t": e1, "dir": 1, "risk_usd": 420.0})
+    p = pushes(b, e1 + 150)
+    check("a. unarmed follower + a LIT signal -> ONE line in the owner's words (not armed, the side and time, arm it at the PC)",
+          len(p) == 1 and p[0]["title"] == "Rapid EOD 25K is not armed" and "it missed Zlarior long at 03:40 ET" in p[0]["body"]
+          and "Arm it at the PC" in p[0]["body"] and "~$420 risk at its size" in p[0]["body"], p)
+    p = pushes(bot_with([ok], [e1]), e1 + 150)
+    check("b. an armed follower that routed it -> nothing", p == [], p)
+    b2 = bot_with([un], [e1, e2])
+    p = pushes(b2, e1 + 150, e2 + 150, e2 + 400)
+    check("c. a second signal the same day on the same unarmed account -> still ONE line", len(p) == 1, [x["body"] for x in p])
+    e3 = ts(2026, 11, 25, 3, 40)
+    b3 = bot_with([un], [e3])
+    ms1, ms3 = LG.missed(b2, e2 + 150), LG.missed(b3, e3 + 150)
+    check("c. ...and the next day gives a new key (a new line)", ms1 and ms3 and ms1[0]["key"] != ms3[0]["key"] and ms1[0]["key"].endswith(":notarmed"),
+          (ms1, ms3))
+    tb = ts(2026, 11, 20, 3, 45)
+    rap = acct("Rapid EOD 25K", False, keys=["ema_lon_vix"], rules={"max_risk_usd": 250.0})
+    b4 = bot_with([], [], atlas=rap, second={"strategies": {"ema_lon_vix": {"trades": [{"entry_t": tb, "dir": -1, "risk_usd": 600.0, "r": 6.635}]}}})
+    p = pushes(b4, tb + 150)
+    check("d. ATLAS on the Rapid (max $250 a trade) missing the EMA +6.6R: one line with ~+$1,659 at its size",
+          len(p) == 1 and "it missed ATLAS short at 03:45 ET" in p[0]["body"] and "~+$1,659 at its size" in p[0]["body"], p)
+    ref = acct("ATLAS 25K", True, keys=["ema_lon_vix"], ledger=[{"side": "sell", "entry_t": tb, "result": {"ok": False, "error": "no account"}}])
+    ref.problem = None
+    b5 = bot_with([], [], atlas=ref, second=b4.second)
+    p = pushes(b5, tb + 150)
+    check("e. other reasons keep the MISSED TRADE line (NinjaTrader refused it), with the size hint", len(p) == 1 and p[0]["title"].startswith("MISSED TRADE")
+          and "refused" in p[0]["body"], p)
+    allt = " ".join(x["title"] + x["body"] for x in pushes(bot_with([un], [e1]), e1 + 150))
+    check("e. ids masked", REAL not in allt, allt)
+    junk = types.SimpleNamespace(running=True, cfg={"adapter": "ninjatrader"}, seen={("entry", "x"), 5}, state=None, accts=None,
+                                 acct_b=None, acct_r=None, acct_r2=None, second="bad")
+    try:
+        r = LG.missed(junk, e1 + 150)
+        ok_ = isinstance(r, list)
+    except Exception as e:  # noqa: BLE001
+        ok_ = False
+        r = e
+    check("e. never raises on junk", ok_, r)
+    print(f"\nmissed alarm: {'ALL PASS' if not FAILS else str(len(FAILS)) + ' FAIL'}")
+    return 1 if FAILS else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
